{
  "name": "jarenjs",
  "private": true,
  "version": "0.19.11",
  "description": "Jaren is a JSON Schema Karen Compiler written in vanilla Javascript.",
  "author": "joham",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/jarenjs.git"
  },
  "workspaces": [
    "./packages/core",
    "./packages/json",
    "./packages/validate",
    "./packages/formats",
    "./packages/refs",
    "./packages/forms",
    "./packages/locales",
    "./packages/view",
    "./packages/app",
    "./components/md",
    "./components/mermaid",
    "./components/calc",
    "./components/charts",
    "./packages/josl",
    "./packages/ai",
    "./packages/website",
    "./benchmark"
  ],
  "scripts": {
    "clean": "rimraf ./dist ./packages/core/dist ./packages/json/dist ./packages/validate/dist ./packages/formats/dist ./packages/refs/dist ./packages/forms/dist ./packages/locales/dist ./packages/view/dist ./packages/app/dist ./packages/josl/dist ./packages/ai/dist ./components/md/dist ./components/mermaid/dist ./components/calc/dist ./components/charts/dist",
    "lint": "eslint packages components test benchmark scripts src esbuild.config.js eslint.config.js",
    "test": "node --no-warnings=ExperimentalWarning --test \"test/**/*.test.js\"",
    "test:core": "node --no-warnings=ExperimentalWarning --test \"test/core/**/*.test.js\"",
    "test:json": "node --no-warnings=ExperimentalWarning --test \"test/json/**/*.test.js\"",
    "test:validate": "node --no-warnings=ExperimentalWarning --test \"test/validate/**/*.test.js\"",
    "test:josl": "node --no-warnings=ExperimentalWarning --test \"test/josl/**/*.test.js\"",
    "test:ai": "node --no-warnings=ExperimentalWarning --test \"test/ai/**/*.test.js\"",
    "test:view": "node --no-warnings=ExperimentalWarning --test \"test/view/**/*.test.js\"",
    "test:md": "node --no-warnings=ExperimentalWarning --test \"test/md/**/*.test.js\"",
    "test:mermaid": "node --no-warnings=ExperimentalWarning --test \"test/mermaid/**/*.test.js\"",
    "test:calc": "node --no-warnings=ExperimentalWarning --test \"test/calc/**/*.test.js\"",
    "test:app": "node --no-warnings=ExperimentalWarning --test \"test/app/**/*.test.js\"",
    "test:website": "node --no-warnings=ExperimentalWarning --test \"test/website/**/*.test.js\"",
    "test:types": "tsc --noEmit -p test/consumer/tsconfig.json",
    "test:tree-shaking": "node ./scripts/check-tree-shaking.js",
    "test:packed": "node ./scripts/check-packed-consumers.js",
    "test:browser": "npm run website:build && playwright test -c packages/website/playwright.config.js",
    "test:packed:release": "node ./scripts/check-packed-consumers.js --require-bun",
    "cover": "c8 --reporter=lcov node --no-warnings=ExperimentalWarning --test \"test/**/*.test.js\"",
    "cover:core": "c8 --reporter=lcov node --no-warnings=ExperimentalWarning --test \"test/core/**/*.test.js\"",
    "cover:json": "c8 --reporter=lcov node --no-warnings=ExperimentalWarning --test \"test/json/**/*.test.js\"",
    "cover:validate": "c8 --reporter=lcov node --no-warnings=ExperimentalWarning --test \"test/validate/**/*.test.js\"",
    "cover:profiler": "npx c8 --reporter=lcov --all --exclude packages/_ --exclude test/ --exclude coverage/ node benchmark/profiler.js --profile-all --iterations 1000",
    "build": "npm run build --workspaces --if-present",
    "build:jaren": "node esbuild.config.js",
    "release:check": "npm run clean && npm run lint && npm test && npm run build && npm run test:types && npm run test:tree-shaking && npm run test:packed:release && npm run pack:check",
    "pack:check": "npm pack --dry-run --workspace=@jarenjs/core --workspace=@jarenjs/json --workspace=@jarenjs/validate --workspace=@jarenjs/formats --workspace=@jarenjs/refs --workspace=@jarenjs/forms --workspace=@jarenjs/locales --workspace=@jarenjs/view --workspace=@jarenjs/app --workspace=@jarenjs/md --workspace=@jarenjs/mermaid --workspace=@jarenjs/calc --workspace=@jarenjs/charts --workspace=@jarenjs/josl --workspace=@jarenjs/ai",
    "publish": "npm run release:check && npm publish --workspace=@jarenjs/core --workspace=@jarenjs/json --workspace=@jarenjs/validate --workspace=@jarenjs/formats --workspace=@jarenjs/refs --workspace=@jarenjs/forms --workspace=@jarenjs/locales --workspace=@jarenjs/view --workspace=@jarenjs/app --workspace=@jarenjs/md --workspace=@jarenjs/mermaid --workspace=@jarenjs/calc --workspace=@jarenjs/charts --workspace=@jarenjs/josl --workspace=@jarenjs/ai",
    "version:patch": "node ./scripts/version-packages.js patch",
    "version:minor": "node ./scripts/version-packages.js minor",
    "version:major": "node ./scripts/version-packages.js major",
    "commit:linux": "git commit -am v$npm_package_version && git tag v$npm_package_version",
    "commit:win32": "git commit -am v%npm_package_version% && git tag v%npm_package_version%",
    "push": "git push && git push --tags",
    "benchmark": "node ./benchmark/index.js",
    "benchmark:jsonpath": "node ./benchmark/jsonpath.js",
    "benchmark:toml": "node ./benchmark/toml.js",
    "benchmark:jsonx-stream": "node ./benchmark/jsonx-stream.js",
    "benchmark:charts": "node ./benchmark/charts.js",
    "benchmark:jsonpath:profile": "node ./benchmark/jsonpath.js --profile --scale",
    "benchmark:jsonpointer": "node ./benchmark/jsonpointer.js",
    "benchmark:jsonpatch": "node ./benchmark/jsonpatch.js",
    "benchmark:jsonquery": "node ./benchmark/jsonquery.js",
    "benchmark:jsonquery:profile": "node ./benchmark/jsonquery.js --profile --scale",
    "benchmark:jslt": "node ./benchmark/jslt.js",
    "benchmark:view": "node ./benchmark/view.js",
    "benchmark:markdown": "node ./benchmark/markdown.js",
    "benchmark:mermaid": "node ./benchmark/mermaid.js",
    "benchmark:jslt:profile": "node ./benchmark/jslt.js --profile --scale",
    "qt3:convert": "node ./benchmark/tools/qt3-convert.js --quiet",
    "benchmark:qt3": "node ./benchmark/qt3-runner.js",
    "benchmark:coverage": "node ./benchmark/coverage.js --dead-code",
    "benchmark:generate": "npm run benchmark:generate --workspace=@jarenjs/website",
    "website:dev": "npm run dev --workspace=@jarenjs/website",
    "website:build": "npm run build --workspace=@jarenjs/website",
    "website:deploy": "npm run deploy --workspace=@jarenjs/website"
  },
  "keywords": [
    "JSON",
    "schema",
    "validator",
    "validation",
    "jsonschema",
    "json-schema",
    "json-schema-validator",
    "json-schema-validation",
    "javascript",
    "typescript",
    "expressive",
    "typechecking"
  ],
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "last 1 chrome version",
    "last 1 chromeandroid version",
    "last 1 firefox version"
  ],
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.5.5",
    "c8": "^10.1.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.9.1",
    "eslint-plugin-json": "^4.0.1",
    "globals": "^15.9.0",
    "lefthook": "^1.7.14",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@jarenjs/app": "^0.19.11",
    "@jarenjs/core": "^0.19.11",
    "@jarenjs/formats": "^0.19.11",
    "@jarenjs/forms": "^0.19.11",
    "@jarenjs/json": "^0.19.11",
    "@jarenjs/md": "^0.19.11",
    "@jarenjs/refs": "^0.19.11",
    "@jarenjs/validate": "^0.19.11",
    "@jarenjs/view": "^0.19.11"
  },
  "bugs": {
    "url": "https://github.com/jklarenbeek/jarenjs/issues"
  },
  "homepage": "https://github.com/jklarenbeek/jarenjs#readme"
}
