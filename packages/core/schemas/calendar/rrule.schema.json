{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarenjs.dev/schemas/jaren-core/calendar/rrule/0.1",
  "title": "Recurrence rule, JSON form (@jarenjs/core/calendar)",
  "description": "The JSON form of an RFC 5545 RECUR value: the rule part names as keys, lists as arrays, UNTIL as a temporal value (date, floating or utc, on a whole second; see the temporal schema). It checks the grammar for every frequency: each part's spelling, range and sign, and the cross-part rules (COUNT with UNTIL; BYWEEKNO only with YEARLY; BYYEARDAY not with DAILY, WEEKLY or MONTHLY; BYMONTHDAY not with WEEKLY; an ordinal BYDAY only with MONTHLY or YEARLY and not with BYWEEKNO; BYSETPOS only with another BY part). BYSECOND stops at 59: a leap second (60) is refused. Not expressible here, and refused by compileRecurrence only: UNTIL of the wrong kind for the start (JY0019) and BYHOUR, BYMINUTE or BYSECOND, or a SECONDLY, MINUTELY or HOURLY rule, with a date start (JY0018).",
  "type": "object",
  "required": [
    "FREQ"
  ],
  "additionalProperties": false,
  "properties": {
    "FREQ": {
      "enum": [
        "SECONDLY",
        "MINUTELY",
        "HOURLY",
        "DAILY",
        "WEEKLY",
        "MONTHLY",
        "YEARLY"
      ]
    },
    "INTERVAL": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "COUNT": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "UNTIL": {
      "$ref": "https://jarenjs.dev/schemas/jaren-core/calendar/temporal/0.1",
      "properties": {
        "kind": {
          "enum": [
            "date",
            "floating",
            "utc"
          ]
        },
        "time": {
          "pattern": "^[0-9]{2}:[0-9]{2}(?::[0-9]{2}(?:\\.0{1,3})?)?$"
        },
        "instant": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.0{1,3})?Z$"
        }
      }
    },
    "BYSECOND": {
      "description": "seconds 0-59",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 59
      }
    },
    "BYMINUTE": {
      "description": "minutes 0-59",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 59
      }
    },
    "BYHOUR": {
      "description": "hours 0-23",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 23
      }
    },
    "BYDAY": {
      "description": "weekdays, each with an optional signed ordinal 1-53",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(?:[+-]?(?:0?[1-9]|[1-4][0-9]|5[0-3]))?(?:MO|TU|WE|TH|FR|SA|SU)$"
      }
    },
    "BYMONTHDAY": {
      "description": "days of the month 1-31 or -31 to -1",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": -31,
        "maximum": 31,
        "not": {
          "const": 0
        }
      }
    },
    "BYYEARDAY": {
      "description": "days of the year 1-366 or -366 to -1",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": -366,
        "maximum": 366,
        "not": {
          "const": 0
        }
      }
    },
    "BYWEEKNO": {
      "description": "weeks of the year 1-53 or -53 to -1",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": -53,
        "maximum": 53,
        "not": {
          "const": 0
        }
      }
    },
    "BYMONTH": {
      "description": "months 1-12",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12
      }
    },
    "BYSETPOS": {
      "description": "positions in the period's set 1-366 or -366 to -1",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": -366,
        "maximum": 366,
        "not": {
          "const": 0
        }
      }
    },
    "WKST": {
      "enum": [
        "MO",
        "TU",
        "WE",
        "TH",
        "FR",
        "SA",
        "SU"
      ]
    }
  },
  "allOf": [
    {
      "not": {
        "required": [
          "COUNT",
          "UNTIL"
        ]
      }
    },
    {
      "if": {
        "required": [
          "BYWEEKNO"
        ]
      },
      "then": {
        "properties": {
          "FREQ": {
            "const": "YEARLY"
          },
          "BYDAY": {
            "items": {
              "pattern": "^(?:MO|TU|WE|TH|FR|SA|SU)$"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "FREQ": {
            "enum": [
              "DAILY",
              "WEEKLY",
              "MONTHLY"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "BYYEARDAY"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "FREQ": {
            "enum": [
              "WEEKLY"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "BYMONTHDAY"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "FREQ": {
            "enum": [
              "SECONDLY",
              "MINUTELY",
              "HOURLY",
              "DAILY",
              "WEEKLY"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "BYDAY": {
            "items": {
              "pattern": "^(?:MO|TU|WE|TH|FR|SA|SU)$"
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "BYSETPOS"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "BYSECOND"
            ]
          },
          {
            "required": [
              "BYMINUTE"
            ]
          },
          {
            "required": [
              "BYHOUR"
            ]
          },
          {
            "required": [
              "BYDAY"
            ]
          },
          {
            "required": [
              "BYMONTHDAY"
            ]
          },
          {
            "required": [
              "BYYEARDAY"
            ]
          },
          {
            "required": [
              "BYWEEKNO"
            ]
          },
          {
            "required": [
              "BYMONTH"
            ]
          }
        ]
      }
    }
  ]
}
