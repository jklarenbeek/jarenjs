{
  "name": "@jarenjs/flow",
  "private": false,
  "version": "0.80.0",
  "type": "module",
  "main": "./src/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/types/",
    "src/",
    "docs/",
    "schemas/"
  ],
  "description": "Executable JSON workflows: pure FSMs and statecharts, concurrent DAGs, deterministic composition and durable checkpoint/resume",
  "author": "joham",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/jarenjs.git",
    "directory": "packages/flow"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "jaren",
    "json",
    "fsm",
    "finite-state-machine",
    "workflow",
    "state-machine"
  ],
  "scripts": {
    "build": "npm run build:types",
    "build:types": "tsc -p tsconfig.json",
    "prepack": "npm run build:types"
  },
  "dependencies": {
    "@jarenjs/core": "^0.80.0",
    "@jarenjs/json": "^0.80.0"
  }
}
