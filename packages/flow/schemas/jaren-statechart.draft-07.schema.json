{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jarenjs.dev/schemas/jaren-fsm/0.2/draft-07",
  "title": "Jaren statechart 0.2",
  "description": "Pure explicit-time statecharts. The compiler proves hierarchy, initial states, legal transition domains and history configuration; this grammar validates document structure.",
  "type": "object",
  "properties": {
    "$fsm": {
      "const": "0.2"
    },
    "initial": {
      "type": "string",
      "minLength": 1
    },
    "states": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "$ref": "#/definitions/state"
          }
        ]
      },
      "minItems": 1
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/transition"
      },
      "minItems": 0
    }
  },
  "required": [
    "$fsm",
    "initial",
    "states",
    "transitions"
  ],
  "additionalProperties": false,
  "definitions": {
    "effects": {
      "description": "Effect descriptors, returned as resolved data when their state or transition fires — the engine never executes them.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "run": {
            "description": "The host-registered handler name.",
            "type": "string",
            "minLength": 1
          },
          "with": {
            "description": "Handler props: a Jaren JSON Query document evaluated against the scope at fire time; an empty result omits the member.",
            "allOf": [
              {
                "$ref": "#/definitions/queryDocument"
              }
            ]
          }
        },
        "required": [
          "run"
        ]
      }
    },
    "queryDocument": {
      "$ref": "https://jarenjs.dev/schemas/jaren-query/0.1/draft-07"
    },
    "state": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "type": "string",
          "minLength": 1
        },
        "initial": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "atomic",
            "compound",
            "parallel",
            "final",
            "history"
          ]
        },
        "history": {
          "enum": [
            "shallow",
            "deep"
          ]
        },
        "final": {
          "type": "boolean"
        },
        "entry": {
          "$ref": "#/definitions/effects"
        },
        "exit": {
          "$ref": "#/definitions/effects"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "type": [
            "string",
            "null"
          ]
        },
        "after": {
          "type": "number",
          "minimum": 0
        },
        "done": {
          "const": true
        },
        "always": {
          "const": true
        },
        "type": {
          "enum": [
            "internal",
            "external"
          ]
        },
        "guard": {
          "$ref": "#/definitions/queryDocument"
        },
        "effects": {
          "$ref": "#/definitions/effects"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "event",
              "after"
            ]
          }
        },
        {
          "not": {
            "required": [
              "event",
              "done"
            ]
          }
        },
        {
          "not": {
            "required": [
              "event",
              "always"
            ]
          }
        },
        {
          "not": {
            "required": [
              "after",
              "done"
            ]
          }
        },
        {
          "not": {
            "required": [
              "after",
              "always"
            ]
          }
        },
        {
          "not": {
            "required": [
              "done",
              "always"
            ]
          }
        }
      ]
    }
  }
}
