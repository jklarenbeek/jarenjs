{
  "$jtlt": "0.1",
  "output": "xml",
  "rules": [
    {
      "match": "$",
      "body": [
        "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n",
        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n",
        "<title>", "$.title", "</title>\n",
        "<style>body{margin:0;min-height:100vh;display:grid;place-items:center;gap:1rem;background:", "$.paper",
        ";color:", "$.ink", ";font:16px/1.4 system-ui,sans-serif}svg{max-width:100vw;height:auto}figcaption{text-align:center}</style>\n",
        "</head>\n<body>\n<figure>\n", { "$raw": "$.svg" }, "\n<figcaption>",
        "$.title", " — tick ", "$.tick", ", harmony ", "$.harmony", ". ",
        { "$apply": "$.council[*]" },
        "</figcaption>\n</figure>\n</body>\n</html>\n"
      ]
    },
    { "match": "$.council[*]", "body": ["$.name", " ", "$.merit", "; "] }
  ]
}
