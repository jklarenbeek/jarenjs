{
  "name": "@jarenjs/website",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "description": "The jarenjs website: the whole site is one JSON app document running on @jarenjs/view + @jarenjs/app — nine live playground engines, an experiment IDE, WebMCP agent tools and offline PWA support.",
  "author": "joham",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "benchmark:generate": "cd ../.. && node benchmark/website-data.js --iterations 1000",
    "predeploy": "npm run benchmark:generate && npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@jarenjs/app": "file:../app",
    "@jarenjs/core": "file:../core",
    "@jarenjs/formats": "file:../formats",
    "@jarenjs/forms": "file:../forms",
    "@jarenjs/json": "file:../json",
    "@jarenjs/locales": "file:../locales",
    "@jarenjs/md": "file:../../components/md",
    "@jarenjs/refs": "file:../refs",
    "@jarenjs/validate": "file:../validate",
    "@jarenjs/view": "file:../view"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "vite": "^6.1.0"
  }
}
