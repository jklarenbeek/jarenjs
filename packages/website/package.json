{
  "name": "@jarenjs/website",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "description": "The Jaren website: complete shared editors, live engines, plain WebMCP operations and offline PWA support.",
  "author": "joham",
  "license": "MIT",
  "scripts": {
    "dev": "npm run site:data && vite",
    "build": "npm run site:data && vite build",
    "site:data": "node ../../scripts/generate-build-info.js && node ../../scripts/generate-site-data.js && node ../../scripts/generate-studio-offline.js",
    "preview": "vite preview",
    "lint": "eslint src",
    "benchmark:generate": "cd ../.. && node benchmark/website-data.js --iterations 1000",
    "predeploy": "node ../../scripts/check-benchmark-drift.js && node ../../scripts/check-sw-cache.js && npm run build",
    "deploy": "gh-pages -d dist",
    "postdeploy": "node ../../scripts/verify-live-site.js",
    "deploy:remeasure": "npm run benchmark:generate && npm run build && gh-pages -d dist",
    "postdeploy:remeasure": "node ../../scripts/verify-live-site.js"
  },
  "dependencies": {
    "@jarenjs/app": "file:../app",
    "@jarenjs/calc": "file:../../components/calc",
    "@jarenjs/charts": "file:../../components/charts",
    "@jarenjs/contract": "file:../contract",
    "@jarenjs/core": "file:../core",
    "@jarenjs/flow": "file:../flow",
    "@jarenjs/formats": "file:../formats",
    "@jarenjs/forms": "file:../forms",
    "@jarenjs/josl": "file:../josl",
    "@jarenjs/json": "file:../json",
    "@jarenjs/linq": "file:../linq",
    "@jarenjs/locales": "file:../locales",
    "@jarenjs/md": "file:../../components/md",
    "@jarenjs/mermaid": "file:../../components/mermaid",
    "@jarenjs/refs": "file:../refs",
    "@jarenjs/play": "file:../../components/play",
    "@jarenjs/studio": "file:../../components/studio",
    "@jarenjs/validate": "file:../validate",
    "@jarenjs/view": "file:../view",
    "@jarenjs/collection": "file:../../components/collection",
    "@jarenjs/rules": "file:../../components/rules"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "gh-pages": "^6.3.0",
    "vite": "^6.1.0"
  }
}
