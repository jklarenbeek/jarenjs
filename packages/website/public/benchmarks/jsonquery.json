"singular","document":"bookstore (10000 books, 4333 ratings)","engines":{"jaren":328.8,"fontoxpath":11070,"jsonata":4752},"iterations":{"jaren":3710,"fontoxpath":1000,"jsonata":1646}},{"scenario":"filter","document":"bookstore (10000 books, 4333 ratings)","engines":{"jaren":1512000,"fontoxpath":324700000,"jsonata":69920000},"iterations":{"jaren":101,"fontoxpath":1,"jsonata":6}},{"scenario":"join","document":"bookstore (10000 books, 4333 ratings)","engines":{},"iterations":{},"capped":1000},{"scenario":"group","document":"bookstore (10000 books, 4333 ratings)","engines":{"jaren":2380000,"fontoxpath":null,"jsonata":38580000},"iterations":{"jaren":82,"jsonata":12}},{"scenario":"reshape","document":"bookstore (10000 books, 4333 ratings)","engines":{"jaren":3542000,"fontoxpath":437000000,"jsonata":120200000},"iterations":{"jaren":103,"fontoxpath":1,"jsonata":3}}],"compile":{"sources":["singular","filter","join","reshape"],"iterations":100,"results":{"jaren":37090,"fontoxpath":566100,"jsonata":112800}},"scenarios":[{"key":"singular","title":"singular access","description":"Bind one book, return its title — the degenerate FLWOR on-ramp and the pattern of a $data-style lookup.","sources":{"fontoxpath":"$doc?store?book?3?title","jaren":"{\"$let\":{\"b\":\"$.store.book[2]\"},\"$return\":\"$b.title\"}","jsonata":"store.book[2].title"}},{"key":"filter","title":"filter + project (spec A.2)","description":"Select the books under $10, order them by price, and project title/price objects.","sources":{"fontoxpath":"for $b in $doc?store?book?*\n  where $b?price lt 10\n  order by $b?price\n  return map { \"title\": $b?title, \"price\": $b?price }","jaren":"{\"$for\":{\"b\":\"$.store.book[*]\"},\"$where\":{\"$lt\":[\"$b.price\",10]},\"$orderby\":\"$b.price\",\"$return\":{\"title\":\"$b.title\",\"price\":\"$b.price\"}}","jsonata":"store.book[price < 10]^(price).{ \"title\": title, \"price\": price }"}},{"key":"join","title":"join (spec A.3)","description":"Correlate books with a ratings array on isbn — a naive O(n·m) nested-loop join in every engine, capped at 1,000 books.","sources":{"fontoxpath":"for $b in $doc?store?book?*, $r in $doc?ratings?*\n  where $b?isbn = $r?isbn\n  order by $b?price\n  return map { \"title\": $b?title, \"stars\": $r?stars }","jaren":"{\"$for\":{\"b\":\"$.store.book[*]\",\"r\":\"$.ratings[*]\"},\"$where\":{\"$eq\":[\"$b.isbn\",\"$r.isbn\"]},\"$orderby\":\"$b.price\",\"$return\":{\"title\":\"$b.title\",\"stars\":\"$r.stars\"}}","jsonata":"(store.book^(price))@$b.$$.ratings@$r[$b.isbn = $r.isbn].{ \"title\": $b.title, \"stars\": $r.stars }"}},{"key":"group","title":"group + aggregate (spec A.4)","description":"Group books by category and compute count and average price per genre. fontoxpath does not implement the XQuery group by clause.","sources":{"jaren":"{\"$for\":{\"b\":\"$.store.book[*]\"},\"$groupby\":{\"genre\":\"$b.category\"},\"$return\":{\"genre\":\"$genre\",\"count\":{\"$count\":\"$b\"},\"avg\":{\"$avg\":\"$b.price\"}}}","jsonata":"(\n  store.book{ category: { \"count\": $count($), \"avg\": $average($.price) } }\n  ~> $each(function($v, $k) { { \"genre\": $k, \"count\": $v.count, \"avg\": $v.avg } })\n)"}},{"key":"reshape","title":"deep reshape","description":"Rebuild the store as a catalog: computed labels, nested pricing objects, and a bicycle summary in one constructor document.","sources":{"fontoxpath":"map { \"catalog\": array { for $b in $doc?store?book?*\n          return map { \"id\": ($b?isbn, $b?title)[1],\n                       \"label\": concat($b?title, \" by \", $b?author),\n                       \"pricing\": map { \"list\": $b?price,\n                                        \"discounted\": $b?price * 0.9 } } },\n        \"bike\": map { \"color\": $doc?store?bicycle?color } }","jaren":"{\"catalog\":[{\"$for\":{\"b\":\"$.store.book[*]\"},\"$return\":{\"id\":{\"$default\":[\"$b.isbn\",\"$b.title\"]},\"label\":{\"$concat\":[\"$b.title\",\" by \",\"$b.author\"]},\"pricing\":{\"list\":\"$b.price\",\"discounted\":{\"$mul\":[\"$b.price\",0.9]}}}}],\"bike\":{\"color\":\"$.store.bicycle.color\"}}","jsonata":"{\n  \"catalog\": [store.book.{ \"id\": [isbn, title][0],\n                           \"label\": title & \" by \" & author,\n                           \"pricing\": { \"list\": price, \"discounted\": price * 0.9 } }],\n  \"bike\": { \"color\": store.bicycle.color } }"}}]}