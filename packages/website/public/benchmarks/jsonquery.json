 array on isbn — a naive O(n·m) nested-loop join in every engine, capped at 1,000 books.","sources":{"fontoxpath":"for $b in $doc?store?book?*, $r in $doc?ratings?*\n  where $b?isbn = $r?isbn\n  order by $b?price\n  return map { \"title\": $b?title, \"stars\": $r?stars }","jaren":"{\"$for\":{\"b\":\"$.store.book[*]\",\"r\":\"$.ratings[*]\"},\"$where\":{\"$eq\":[\"$b.isbn\",\"$r.isbn\"]},\"$orderby\":\"$b.price\",\"$return\":{\"title\":\"$b.title\",\"stars\":\"$r.stars\"}}","jsonata":"(store.book^(price))@$b.$$.ratings@$r[$b.isbn = $r.isbn].{ \"title\": $b.title, \"stars\": $r.stars }"}},{"key":"group","title":"group + aggregate (spec A.4)","description":"Group books by category and compute count and average price per genre. fontoxpath does not implement the XQuery group by clause.","sources":{"jaren":"{\"$for\":{\"b\":\"$.store.book[*]\"},\"$groupby\":{\"genre\":\"$b.category\"},\"$return\":{\"genre\":\"$genre\",\"count\":{\"$count\":\"$b\"},\"avg\":{\"$avg\":\"$b.price\"}}}","jsonata":"(\n  store.book{ category: { \"count\": $count($), \"avg\": $average($.price) } }\n  ~> $each(function($v, $k) { { \"genre\": $k, \"count\": $v.count, \"avg\": $v.avg } })\n)"}},{"key":"reshape","title":"deep reshape","description":"Rebuild the store as a catalog: computed labels, nested pricing objects, and a bicycle summary in one constructor document.","sources":{"fontoxpath":"map { \"catalog\": array { for $b in $doc?store?book?*\n          return map { \"id\": ($b?isbn, $b?title)[1],\n                       \"label\": concat($b?title, \" by \", $b?author),\n                       \"pricing\": map { \"list\": $b?price,\n                                        \"discounted\": $b?price * 0.9 } } },\n        \"bike\": map { \"color\": $doc?store?bicycle?color } }","jaren":"{\"catalog\":[{\"$for\":{\"b\":\"$.store.book[*]\"},\"$return\":{\"id\":{\"$default\":[\"$b.isbn\",\"$b.title\"]},\"label\":{\"$concat\":[\"$b.title\",\" by \",\"$b.author\"]},\"pricing\":{\"list\":\"$b.price\",\"discounted\":{\"$mul\":[\"$b.price\",0.9]}}}}],\"bike\":{\"color\":\"$.store.bicycle.color\"}}","jsonata":"{\n  \"catalog\": [store.book.{ \"id\": [isbn, title][0],\n                           \"label\": title & \" by \" & author,\n                           \"pricing\": { \"list\": price, \"discounted\": price * 0.9 } }],\n  \"bike\": { \"color\": store.bicycle.color } }"}}]}