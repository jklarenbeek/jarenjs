{
  "name": "@jarenjs/json",
  "private": false,
  "version": "0.33.4",
  "type": "module",
  "main": "./src/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "files": [
    "src/",
    "dist/types/",
    "docs/",
    "schemas/",
    "ARCHITECTURE.md"
  ],
  "description": "Jaren JSON Addressing Standards",
  "author": "joham",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/jarenjs.git",
    "directory": "packages/json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "jaren",
    "json",
    "json-pointer",
    "jsonpath",
    "json-patch",
    "merge-patch"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.js"
    },
    "./basic": {
      "types": "./dist/types/basic.d.ts",
      "default": "./src/basic.js"
    },
    "./canonical": {
      "types": "./dist/types/canonical.d.ts",
      "default": "./src/canonical.js"
    },
    "./pointer": {
      "types": "./dist/types/pointer.d.ts",
      "default": "./src/pointer.js"
    },
    "./path": {
      "types": "./dist/types/path.d.ts",
      "default": "./src/path.js"
    },
    "./patch": {
      "types": "./dist/types/patch.d.ts",
      "default": "./src/patch.js"
    },
    "./write": {
      "types": "./dist/types/write.d.ts",
      "default": "./src/write.js"
    },
    "./query": {
      "types": "./dist/types/query/index.d.ts",
      "default": "./src/query/index.js"
    },
    "./jslt": {
      "types": "./dist/types/jslt/index.d.ts",
      "default": "./src/jslt/index.js"
    },
    "./jtlt": {
      "types": "./dist/types/jtlt/index.d.ts",
      "default": "./src/jtlt/index.js"
    },
    "./xquery": {
      "types": "./dist/types/xquery/index.d.ts",
      "default": "./src/xquery/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:types",
    "build:types": "tsc -p tsconfig.json",
    "prepack": "npm run build:types"
  },
  "dependencies": {
    "@jarenjs/core": "^0.33.4"
  }
}
