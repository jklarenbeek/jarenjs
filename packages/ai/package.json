{
  "name": "@jarenjs/ai",
  "private": false,
  "version": "0.48.1",
  "type": "module",
  "main": "./src/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "description": "Browser-side AI that makes sense: one OpenAI-compatible chat client for OpenRouter, Ollama and LM Studio (bring your own key), an SSE stream decoder, a JSON-Schema-validated tool registry guarded by Jaren itself, a bounded agent loop, and WebMCP (navigator.modelContext) registration.",
  "author": "joham",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/jarenjs.git",
    "directory": "packages/ai"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "jaren",
    "ai",
    "llm",
    "agent",
    "tools",
    "function-calling",
    "webmcp",
    "openrouter",
    "ollama",
    "lmstudio",
    "sse",
    "streaming",
    "json-schema"
  ],
  "scripts": {
    "build": "npm run build:types",
    "build:types": "tsc -p tsconfig.json",
    "prepack": "npm run build:types"
  },
  "files": [
    "dist/types/",
    "src/"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.js"
    },
    "./providers": {
      "types": "./dist/types/providers.d.ts",
      "default": "./src/providers.js"
    },
    "./sse": {
      "types": "./dist/types/sse.d.ts",
      "default": "./src/sse.js"
    },
    "./client": {
      "types": "./dist/types/client.d.ts",
      "default": "./src/client.js"
    },
    "./embed": {
      "types": "./dist/types/embed.d.ts",
      "default": "./src/embed.js"
    },
    "./structured": {
      "types": "./dist/types/structured.d.ts",
      "default": "./src/structured.js"
    },
    "./toolbox": {
      "types": "./dist/types/toolbox.d.ts",
      "default": "./src/toolbox.js"
    },
    "./agent": {
      "types": "./dist/types/agent.d.ts",
      "default": "./src/agent.js"
    },
    "./recall": {
      "types": "./dist/types/recall.d.ts",
      "default": "./src/recall.js"
    },
    "./ledger": {
      "types": "./dist/types/ledger.d.ts",
      "default": "./src/ledger.js"
    },
    "./environment": {
      "types": "./dist/types/environment.d.ts",
      "default": "./src/environment.js"
    },
    "./program": {
      "types": "./dist/types/program.d.ts",
      "default": "./src/program.js"
    },
    "./recursive": {
      "types": "./dist/types/recursive.d.ts",
      "default": "./src/recursive.js"
    },
    "./stylesheet": {
      "types": "./dist/types/stylesheet.d.ts",
      "default": "./src/stylesheet.js"
    },
    "./spatial": {
      "types": "./dist/types/spatial.d.ts",
      "default": "./src/spatial.js"
    },
    "./geo-tools": {
      "types": "./dist/types/geo-tools.d.ts",
      "default": "./src/geo-tools.js"
    },
    "./refine": {
      "types": "./dist/types/refine.d.ts",
      "default": "./src/refine.js"
    },
    "./storage/memory": {
      "types": "./dist/types/storage/memory.d.ts",
      "default": "./src/storage/memory.js"
    },
    "./schemas/ledger": {
      "types": "./dist/types/schemas/ledger.d.ts",
      "default": "./src/schemas/ledger.js"
    },
    "./schemas/patch": {
      "types": "./dist/types/schemas/patch.d.ts",
      "default": "./src/schemas/patch.js"
    },
    "./schemas/program": {
      "types": "./dist/types/schemas/program.d.ts",
      "default": "./src/schemas/program.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@jarenjs/core": "^0.48.1",
    "@jarenjs/validate": "^0.48.1"
  }
}
