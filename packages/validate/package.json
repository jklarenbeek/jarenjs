{
  "name": "@jarenjs/validate",
  "private": false,
  "version": "0.84.2",
  "type": "module",
  "main": "./src/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.js"
    },
    "./query": {
      "types": "./dist/types/query.d.ts",
      "default": "./src/query.js"
    },
    "./normalize": {
      "types": "./dist/types/normalize.d.ts",
      "default": "./src/normalize.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/types/",
    "src/",
    "docs/",
    "ARCHITECTURE.md"
  ],
  "description": "Jaren is a JavaScript JSON Schema Validator",
  "author": "joham",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/jarenjs.git",
    "directory": "packages/validate"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "jaren",
    "json",
    "schema",
    "validate",
    "validator"
  ],
  "scripts": {
    "build": "node esbuild.config.js && npm run build:types",
    "build:types": "tsc -p tsconfig.json",
    "prepack": "npm run build:types"
  },
  "dependencies": {
    "@jarenjs/core": "^0.84.2",
    "@jarenjs/json": "^0.84.2"
  }
}
