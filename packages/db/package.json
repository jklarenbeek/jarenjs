{
  "name": "@jarenjs/db",
  "private": false,
  "version": "0.77.0",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./node": {
      "types": "./types/node.d.ts",
      "default": "./src/drivers/node.js"
    },
    "./postgres": {
      "types": "./types/postgres.d.ts",
      "default": "./src/drivers/postgres.js"
    },
    "./bun": {
      "types": "./types/bun.d.ts",
      "default": "./src/drivers/bun.js"
    },
    "./wasm": {
      "types": "./types/wasm.d.ts",
      "default": "./src/drivers/wasm.js"
    },
    "./typed": {
      "types": "./types/typed.d.ts",
      "default": "./src/typed.js"
    },
    "./app": {
      "types": "./types/app.d.ts",
      "default": "./src/app.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json",
    "./node-worker": {
      "types": "./types/node-worker.d.ts",
      "default": "./src/drivers/node-worker.js"
    },
    "./node-pool": {
      "types": "./types/node-pool.d.ts",
      "default": "./src/drivers/node-pool.js"
    }
  },
  "files": [
    "types/",
    "src/",
    "schemas/",
    "docs/",
    "ARCHITECTURE.md"
  ],
  "description": "Document storage for the Jaren suite: a model document declares collections as JSON Schemas with indexes; openStore applies DDL through a dialect and gives transactional, schema-validated reads and writes over SQLite (Node, Bun, or an injected wasm handle) or PostgreSQL 16+ through an injected client",
  "author": "joham",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/jarenjs.git",
    "directory": "packages/db"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "jaren",
    "json",
    "sqlite",
    "document-store",
    "json-schema",
    "database",
    "postgres",
    "postgresql"
  ],
  "scripts": {
    "build": "npm run build:types",
    "build:types": "tsc -p tsconfig.json",
    "prepack": "npm run build:types"
  },
  "dependencies": {
    "@jarenjs/core": "^0.77.0",
    "@jarenjs/json": "^0.77.0",
    "@jarenjs/validate": "^0.77.0"
  },
  "bin": {
    "jaren-db": "./src/cli.js"
  }
}
