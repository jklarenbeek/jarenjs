{
  "name": "@jarenjs/db",
  "private": false,
  "version": "0.25.9",
  "type": "module",
  "main": "./src/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.js"
    },
    "./node": {
      "types": "./dist/types/drivers/node.d.ts",
      "default": "./src/drivers/node.js"
    },
    "./bun": {
      "types": "./dist/types/drivers/bun.d.ts",
      "default": "./src/drivers/bun.js"
    },
    "./wasm": {
      "types": "./dist/types/drivers/wasm.d.ts",
      "default": "./src/drivers/wasm.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/types/",
    "src/",
    "schemas/",
    "docs/",
    "ARCHITECTURE.md"
  ],
  "description": "Document storage for the Jaren suite: a model document declares collections as JSON Schemas with indexes; openStore applies DDL through a dialect and gives transactional, schema-validated reads and writes over SQLite on Node, Bun, or an injected wasm handle",
  "author": "joham",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/jarenjs.git",
    "directory": "packages/db"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "jaren",
    "json",
    "sqlite",
    "document-store",
    "json-schema",
    "database"
  ],
  "scripts": {
    "build": "npm run build:types",
    "build:types": "tsc -p tsconfig.json",
    "prepack": "npm run build:types"
  },
  "dependencies": {
    "@jarenjs/core": "^0.25.9",
    "@jarenjs/json": "^0.25.9"
  }
}
