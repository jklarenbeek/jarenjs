{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarenjs.dev/schemas/jaren-replication-snapshot",
  "title": "Bounded replication snapshot and frontier handshake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$replicationSnapshot",
    "model",
    "frontier",
    "rows",
    "receipts"
  ],
  "properties": {
    "$replicationSnapshot": {
      "const": "0.1"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "frontier": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "table",
          "key",
          "value",
          "frontier"
        ],
        "properties": {
          "table": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "key": {
            "type": "string"
          },
          "value": {
            "type": [
              "object",
              "null"
            ]
          },
          "frontier": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "$ref": "https://jarenjs.dev/schemas/jaren-replication"
      }
    }
  }
}
