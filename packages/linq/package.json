{
  "name": "@jarenjs/linq",
  "private": false,
  "version": "0.84.3",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./schema": {
      "types": "./types/schema.d.ts",
      "default": "./src/schema/index.js"
    },
    "./model": {
      "types": "./types/model.d.ts",
      "default": "./src/model/index.js"
    },
    "./jslt": {
      "types": "./types/jslt.d.ts",
      "default": "./src/jslt/index.js"
    },
    "./migration": {
      "types": "./types/migration.d.ts",
      "default": "./src/migration/index.js"
    },
    "./contract": {
      "types": "./types/contract.d.ts",
      "default": "./src/contract/index.js"
    },
    "./flow": {
      "types": "./types/flow.d.ts",
      "default": "./src/flow/index.js"
    },
    "./app": {
      "types": "./types/app.d.ts",
      "default": "./src/app/index.js"
    },
    "./forms": {
      "types": "./types/forms.d.ts",
      "default": "./src/forms/index.js"
    },
    "./db": {
      "types": "./types/db.d.ts",
      "default": "./src/db/index.js"
    },
    "./package.json": "./package.json",
    "./charts": {
      "types": "./types/charts.d.ts",
      "default": "./src/charts/index.js"
    },
    "./project": {
      "types": "./types/project.d.ts",
      "default": "./src/project/index.js"
    },
    "./jtlt": {
      "types": "./types/jtlt.d.ts",
      "default": "./src/jtlt/index.js"
    },
    "./messages": {
      "types": "./types/messages.d.ts",
      "default": "./src/messages/index.js"
    },
    "./formula": {
      "types": "./types/formula.d.ts",
      "default": "./src/formula/index.js"
    },
    "./authoring": {
      "types": "./types/authoring.d.ts",
      "default": "./src/authoring.js"
    }
  },
  "files": [
    "types/",
    "src/",
    "docs/",
    "ARCHITECTURE.md"
  ],
  "description": "A C#-familiar fluent LINQ surface for the Jaren suite: expression capture into plain query documents, deferred immutable sequences, and a provider seam that runs the same document in memory or anywhere else",
  "author": "joham",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/jarenjs.git",
    "directory": "packages/linq"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "jaren",
    "json",
    "linq",
    "query",
    "fluent",
    "expression-tree"
  ],
  "scripts": {
    "build": "npm run build:types",
    "build:types": "tsc -p tsconfig.json",
    "prepack": "npm run build:types"
  },
  "dependencies": {
    "@jarenjs/core": "^0.84.3",
    "@jarenjs/json": "^0.84.3"
  },
  "peerDependencies": {
    "@jarenjs/db": "^0.84.3",
    "@jarenjs/formats": "^0.84.3",
    "@jarenjs/validate": "^0.84.3"
  },
  "peerDependenciesMeta": {
    "@jarenjs/db": {
      "optional": true
    },
    "@jarenjs/formats": {
      "optional": true
    },
    "@jarenjs/validate": {
      "optional": true
    }
  }
}
