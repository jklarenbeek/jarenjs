{
  "name": "@jarenjs/app",
  "private": false,
  "version": "0.90.3",
  "type": "module",
  "main": "./src/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./routes": {
      "types": "./dist/types/routes.d.ts",
      "default": "./src/routes.js"
    },
    "./dialog": {
      "types": "./dist/types/dialog.d.ts",
      "default": "./src/dialog.js"
    },
    "./file-tokens": {
      "types": "./dist/types/file-tokens.d.ts",
      "default": "./src/file-tokens.js"
    },
    "./search": {
      "types": "./dist/types/search.d.ts",
      "default": "./src/search.js"
    },
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json",
    "./formula": {
      "types": "./dist/types/formula.d.ts",
      "default": "./src/formula.js"
    }
  },
  "files": [
    "dist/types/",
    "src/",
    "docs/",
    "schemas/"
  ],
  "description": "Applications as JSON documents: hyperapp's dispatch loop rebuilt on the Jaren suite — JSLT views, query-document actions, JSON Patch transitions",
  "author": "joham",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/jarenjs.git",
    "directory": "packages/app"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "jaren",
    "json",
    "app",
    "framework",
    "hyperapp",
    "jslt",
    "state"
  ],
  "scripts": {
    "build": "npm run build:types",
    "build:types": "tsc -p tsconfig.json",
    "prepack": "npm run build:types"
  },
  "dependencies": {
    "@jarenjs/core": "^0.90.3",
    "@jarenjs/json": "^0.90.3",
    "@jarenjs/view": "^0.90.3"
  }
}
