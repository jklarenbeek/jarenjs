{
  "name": "@jarenjs/emit",
  "private": false,
  "version": "0.31.5",
  "type": "module",
  "main": "./src/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "bin": {
    "jaren-emit": "./src/cli.js"
  },
  "files": [
    "dist/types/",
    "src/",
    "schemas/",
    "docs/",
    "ARCHITECTURE.md"
  ],
  "description": "Build-time artifacts from JSON documents: JSON Schema to TypeScript declarations and beyond, via JTLT stylesheets",
  "author": "joham",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/jarenjs.git",
    "directory": "packages/emit"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "jaren",
    "json-schema",
    "typescript",
    "codegen",
    "code-generation",
    "types",
    "dts",
    "json-schema-to-typescript",
    "jtlt"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.js"
    },
    "./model": {
      "types": "./dist/types/model.d.ts",
      "default": "./src/model.js"
    },
    "./typescript": {
      "types": "./dist/types/typescript.d.ts",
      "default": "./src/typescript.js"
    },
    "./markdown": {
      "types": "./dist/types/markdown.d.ts",
      "default": "./src/markdown.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:types",
    "build:types": "tsc -p tsconfig.json",
    "prepack": "npm run build:types"
  },
  "dependencies": {
    "@jarenjs/core": "^0.31.5",
    "@jarenjs/json": "^0.31.5",
    "@jarenjs/validate": "^0.31.5"
  }
}
