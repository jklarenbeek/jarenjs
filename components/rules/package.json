{
  "name": "@jarenjs/rules",
  "private": false,
  "version": "0.83.3",
  "type": "module",
  "main": "./src/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.js"
    },
    "./component": {
      "types": "./dist/types/component/index.d.ts",
      "default": "./src/component/index.js"
    },
    "./package.json": "./package.json",
    "./styles/rules.css": "./styles/rules.css"
  },
  "files": [
    "src/",
    "dist/types/",
    "styles/",
    "docs/",
    "ARCHITECTURE.md"
  ],
  "description": "Saved rule authoring and reviewed plans through injected formula and command services",
  "author": "joham",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/jarenjs.git",
    "directory": "components/rules"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "jaren",
    "rules",
    "formula"
  ],
  "scripts": {
    "build": "npm run build:types",
    "build:types": "tsc -p tsconfig.json",
    "prepack": "npm run build:types"
  },
  "dependencies": {
    "@jarenjs/core": "^0.83.3",
    "@jarenjs/view": "^0.83.3",
    "@jarenjs/app": "^0.83.3",
    "@jarenjs/forms": "^0.83.3"
  }
}
