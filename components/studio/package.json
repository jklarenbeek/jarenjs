{
  "name": "@jarenjs/studio",
  "private": false,
  "version": "0.87.0",
  "type": "module",
  "main": "./src/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.js"
    },
    "./component": {
      "types": "./dist/types/component/index.d.ts",
      "default": "./src/component/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./styles/studio.css": "./styles/studio.css",
    "./package.json": "./package.json",
    "./export": {
      "types": "./dist/types/export.d.ts",
      "default": "./src/export.js"
    },
    "./flow": {
      "types": "./dist/types/component/flow/index.d.ts",
      "default": "./src/component/flow/index.js"
    },
    "./styles/flow.css": "./styles/flow.css",
    "./styles/editor.css": "./styles/editor.css",
    "./data": {
      "types": "./dist/types/component/data/index.d.ts",
      "default": "./src/component/data/index.js"
    },
    "./data/host": {
      "types": "./dist/types/data/host.d.ts",
      "default": "./src/data/host.js"
    },
    "./contracts/data.contract.json": "./contracts/data.contract.json",
    "./styles/data.css": "./styles/data.css"
  },
  "files": [
    "dist/types/",
    "src/",
    "docs/",
    "schemas/",
    "styles/",
    "contracts/"
  ],
  "description": "The jaren project IDE: a multi-file project (schema, view, actions, model, queries, flow) is one document; each file is validated against its own grammar, assembled into runnable artifacts, and edited/hosted by the studio widget. The engine is headless; the component layer is the IDE.",
  "author": "joham",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/jarenjs.git",
    "directory": "components/studio"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "jaren",
    "json",
    "ide",
    "studio",
    "project",
    "editor",
    "codepen",
    "playground",
    "document",
    "headless"
  ],
  "scripts": {
    "build": "npm run build:types",
    "build:types": "tsc -p tsconfig.json",
    "prepack": "npm run build:types"
  },
  "dependencies": {
    "@jarenjs/core": "^0.87.0",
    "@jarenjs/validate": "^0.87.0",
    "@jarenjs/json": "^0.87.0",
    "@jarenjs/app": "^0.87.0",
    "@jarenjs/flow": "^0.87.0",
    "@jarenjs/db": "^0.87.0",
    "@jarenjs/contract": "^0.87.0",
    "@jarenjs/view": "^0.87.0",
    "@jarenjs/forms": "^0.87.0",
    "@jarenjs/formats": "^0.87.0",
    "@jarenjs/charts": "^0.87.0",
    "@jarenjs/mermaid": "^0.87.0"
  }
}
