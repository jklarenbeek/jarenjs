{
  "$jslt": "0.1",
  "rules": [
    {
      "match": "$",
      "body": {
        "initial": "$.ast.transitions[?(@.from == \"[*]\")].to",
        "states": [
          { "$for": { "s": "$.ast.states[*]" }, "$return": "$s.id" }
        ],
        "transitions": [
          {
            "$for": { "t": "$.ast.transitions[?(@.to != \"[*]\" && @.from != \"[*]\")]" },
            "$return": { "from": "$t.from", "event": "$t.event", "to": "$t.to" }
          }
        ]
      }
    }
  ]
}
