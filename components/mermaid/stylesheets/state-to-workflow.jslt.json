{
  "$jslt": "0.1",
  "rules": [
    {
      "match": "$",
      "body": {
        "initial": "$.ast.transitions[?(@.from == \"[*]\")].to",
        "states": [
          { "$for": { "s": "$.ast.states[*]" }, "$return": "$s.id" }
        ],
        "transitions": [
          {
            "$for": { "t": "$.ast.transitions[?(@.to != \"[*]\" && @.from != \"[*]\")]" },
            "$return": {
              "from": "$t.from",
              "event": "$t.event",
              "guard": { "$if": ["$t.guard", "$t.guard"] },
              "to": "$t.to",
              "effects": { "$if": ["$t.effect", [{ "run": "$t.effect" }]] }
            }
          }
        ]
      }
    }
  ]
}
