{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarenjs.dev/schemas/jaren-calc-state.schema.json",
  "title": "Jaren calc state slice",
  "description": "The plain-JSON $.calc state slice. Draft-neutral.",
  "type": "object",
  "properties": {
    "mode": { "enum": ["standard", "scientific", "programmer", "financial", "converter"] },
    "entry": { "type": "string" },
    "ans": { "type": "number" },
    "ansExact": {
      "type": "string",
      "pattern": "^(-?[0-9]+)?$",
      "description": "The programmer-mode ans as the decimal integer it is, written beside `ans` when the word is beyond 2^53 (a Number holds it rounded). The empty text, or an absent member, means `ans` is exact. A reader trusts the text only while it is the integer `ans` rounds from."
    },
    "memory": { "type": "number" },
    "memoryExact": {
      "type": "string",
      "pattern": "^(-?[0-9]+)?$",
      "description": "The memory register as the decimal integer it is, beside `memory`, on the same terms as `ansExact`."
    },
    "angleMode": { "enum": ["rad", "deg", "grad"] },
    "base": { "enum": ["HEX", "DEC", "OCT", "BIN"] },
    "wordBits": { "enum": [8, 16, 32, 64] },
    "signed": { "type": "boolean" },
    "tape": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "expr": { "type": "string" }, "result": { "type": "string" } }
      }
    },
    "plot": {
      "type": "object",
      "properties": {
        "expr": { "type": "string" },
        "kind": { "enum": ["2d", "3d"] }
      }
    },
    "fin": { "$ref": "financial-inputs.schema.json" },
    "conv": {
      "type": "object",
      "properties": {
        "dimension": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "value": { "type": "number" }
      }
    },
    "rates": {
      "type": "object",
      "properties": {
        "base": { "type": "string" },
        "rates": { "type": "object" },
        "at": { "type": "number" },
        "stale": { "type": "boolean" },
        "status": { "type": "string" }
      }
    }
  },
  "required": ["mode", "entry"]
}
