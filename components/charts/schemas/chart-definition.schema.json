{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarenjs.github.io/schemas/chart-definition.schema.json",
  "title": "Chart definition",
  "description": "A self-contained chart definition for @jarenjs/charts compileChart: the type, presentation fields, and (inline) the data fields the type reads. Streaming callers may omit the data fields and pass data separately.",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {
      "enum": ["pie", "bar", "line", "scatter", "candlestick", "radar", "gauge", "boxplot", "heatmap", "treemap", "streamgraph", "sankey", "map"]
    },
    "title": {
      "type": ["string", "null"]
    },
    "stream": { "$ref": "#/$defs/streamSpec" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "pie" } } },
      "then": {
        "properties": {
          "donut": {
            "description": "true for the default hole fraction, or the hole radius as a fraction of the outer radius",
            "type": ["boolean", "number"],
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          },
          "slices": {
            "type": "array",
            "items": { "$ref": "#/$defs/slice" }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "bar" } } },
      "then": {
        "properties": {
          "stacked": { "type": "boolean" },
          "log": { "type": "boolean" },
          "orient": { "enum": ["v", "h"] },
          "catLabel": { "type": ["string", "null"] },
          "valLabel": { "type": ["string", "null"] },
          "categories": {
            "type": "array",
            "items": { "type": "string" }
          },
          "series": {
            "type": "array",
            "items": { "$ref": "#/$defs/barSeries" }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "line" } } },
      "then": {
        "properties": {
          "x": { "enum": ["linear", "time"] },
          "log": { "type": "boolean" },
          "markers": { "type": "boolean" },
          "xLabel": { "type": ["string", "null"] },
          "yLabel": { "type": ["string", "null"] },
          "domain": { "$ref": "#/$defs/domainPolicy" },
          "sampling": { "$ref": "#/$defs/samplingPolicy" },
          "series": {
            "type": "array",
            "items": { "$ref": "#/$defs/lineSeries" }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "candlestick" } } },
      "then": {
        "properties": {
          "xLabel": { "type": ["string", "null"] },
          "yLabel": { "type": ["string", "null"] },
          "domain": { "$ref": "#/$defs/domainPolicy" },
          "candles": {
            "type": "array",
            "items": { "$ref": "#/$defs/candle" }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "scatter" } } },
      "then": {
        "properties": {
          "xLog": { "type": "boolean" },
          "yLog": { "type": "boolean" },
          "refY": { "type": "number" },
          "refLabel": { "type": ["string", "null"] },
          "xLabel": { "type": ["string", "null"] },
          "yLabel": { "type": ["string", "null"] },
          "points": {
            "type": "array",
            "items": { "$ref": "#/$defs/point" }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "radar" } } },
      "then": {
        "properties": {
          "max": { "type": "number", "exclusiveMinimum": 0 },
          "axes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "series": {
            "type": "array",
            "items": { "$ref": "#/$defs/valueSeries" }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "gauge" } } },
      "then": {
        "properties": {
          "value": { "type": "number" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "unit": { "type": ["string", "null"] },
          "tone": { "$ref": "#/$defs/tone" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "boxplot" } } },
      "then": {
        "properties": {
          "catLabel": { "type": ["string", "null"] },
          "valLabel": { "type": ["string", "null"] },
          "boxes": {
            "type": "array",
            "items": { "$ref": "#/$defs/box" }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "heatmap" } } },
      "then": {
        "properties": {
          "log": { "type": "boolean" },
          "xLabel": { "type": ["string", "null"] },
          "yLabel": { "type": ["string", "null"] },
          "xLabels": {
            "type": "array",
            "items": { "type": "string" }
          },
          "yLabels": {
            "type": "array",
            "items": { "type": "string" }
          },
          "values": {
            "description": "values[yi][xi], row-major from the top row; null marks a missing cell",
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "treemap" } } },
      "then": {
        "properties": {
          "aspect": { "type": "number", "exclusiveMinimum": 0 },
          "items": {
            "description": "leaves, or one level of groups; a chart with any group treats a bare leaf as a group of one",
            "type": "array",
            "items": {
              "anyOf": [
                { "$ref": "#/$defs/treemapItem" },
                { "$ref": "#/$defs/treemapGroup" }
              ]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "streamgraph" } } },
      "then": {
        "properties": {
          "xLabel": { "type": ["string", "null"] },
          "xs": {
            "type": "array",
            "items": { "type": "number" }
          },
          "series": {
            "type": "array",
            "items": { "$ref": "#/$defs/valueSeries" }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "sankey" } } },
      "then": {
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "anyOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["name"],
                  "properties": { "name": { "type": "string" } }
                }
              ]
            }
          },
          "links": {
            "type": "array",
            "items": { "$ref": "#/$defs/sankeyLink" }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "map" } } },
      "then": {
        "properties": {
          "value": {
            "description": "feature property to shade by; absent leaves the map unshaded",
            "type": "string"
          },
          "label": {
            "description": "feature property to name features by (default 'name')",
            "type": "string"
          },
          "log": { "type": "boolean" },
          "aspect": { "type": "number", "exclusiveMinimum": 0 },
          "simplify": {
            "description": "Douglas-Peucker tolerance as a fraction of the frame's width, or false to keep every vertex",
            "type": ["number", "boolean"],
            "minimum": 0
          },
          "features": {
            "description": "GeoJSON: a FeatureCollection, or an array of Features or geometries",
            "type": ["object", "array"]
          },
          "points": {
            "type": "array",
            "items": { "$ref": "#/$defs/mapPoint" }
          }
        }
      }
    }
  ],
  "$defs": {
    "streamSpec": {
      "description": "createStreamAdapter mapping: how reader events accumulate into this chart's data",
      "type": "object",
      "properties": {
        "recordPath": {
          "type": "array",
          "items": { "type": ["string", "number"] }
        },
        "recordBoundary": { "enum": ["path", "document"] },
        "xField": { "type": "string" },
        "yField": { "type": "string" },
        "seriesField": { "type": "string" },
        "maxPoints": { "type": "integer", "minimum": 1 }
      }
    },
    "slice": {
      "type": "object",
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "number", "minimum": 0 }
      }
    },
    "tone": {
      "enum": ["win", "loss", null]
    },
    "barSeries": {
      "type": "object",
      "required": ["name", "values"],
      "properties": {
        "name": { "type": "string" },
        "values": {
          "type": "array",
          "items": { "type": ["number", "null"] }
        },
        "tone": { "$ref": "#/$defs/tone" },
        "tones": {
          "type": "array",
          "items": { "$ref": "#/$defs/tone" }
        }
      }
    },
    "lineSeries": {
      "type": "object",
      "required": ["name", "points"],
      "properties": {
        "name": { "type": "string" },
        "points": {
          "type": "array",
          "items": { "$ref": "#/$defs/point" }
        }
      }
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "tone": { "$ref": "#/$defs/tone" }
      }
    },
    "candle": {
      "type": "object",
      "required": ["t", "open", "high", "low", "close"],
      "properties": {
        "t": { "type": "number" },
        "open": { "type": "number" },
        "high": { "type": "number" },
        "low": { "type": "number" },
        "close": { "type": "number" }
      }
    },
    "valueSeries": {
      "description": "a named series of index-aligned values (radar axes / streamgraph samples)",
      "type": "object",
      "required": ["name", "values"],
      "properties": {
        "name": { "type": "string" },
        "values": {
          "type": "array",
          "items": { "type": ["number", "null"] }
        }
      }
    },
    "box": {
      "description": "one boxplot category: raw samples in `values`, or a precomputed five-number summary",
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": "string" },
        "values": {
          "type": "array",
          "items": { "type": ["number", "null"] }
        },
        "min": { "type": "number" },
        "q1": { "type": "number" },
        "med": { "type": "number" },
        "q3": { "type": "number" },
        "max": { "type": "number" },
        "outliers": {
          "type": "array",
          "items": { "type": "number" }
        }
      },
      "anyOf": [
        { "required": ["values"] },
        { "required": ["min", "q1", "med", "q3", "max"] }
      ]
    },
    "treemapItem": {
      "type": "object",
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "treemapGroup": {
      "description": "one hierarchy level: the group's value is its children's sum",
      "type": "object",
      "required": ["label", "children"],
      "properties": {
        "label": { "type": "string" },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/treemapItem" }
        }
      }
    },
    "sankeyLink": {
      "description": "a flow from source to target; endpoints are node names or node indexes",
      "type": "object",
      "required": ["source", "target", "value"],
      "properties": {
        "source": { "type": ["string", "integer"] },
        "target": { "type": ["string", "integer"] },
        "value": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "mapPoint": {
      "description": "a place marker: the convenience path for a caller holding positions rather than GeoJSON",
      "type": "object",
      "required": ["at"],
      "properties": {
        "at": {
          "description": "a GeoJSON position: [longitude, latitude]",
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "type": "number" },
          "prefixItems": [
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "number", "minimum": -90, "maximum": 90 }
          ]
        },
        "label": { "type": "string" },
        "value": { "type": "number" }
      }
    },
    "samplingPolicy": {
      "description": "how many of a line's points are drawn: false never samples, a method name or object samples whatever the count, and an omitted member samples a TIME line above 2000 points through @jarenjs/core/series. Distinct from stream.maxPoints, which decides what exists rather than what is drawn.",
      "anyOf": [
        { "const": false },
        { "enum": ["lttb", "minmax"] },
        {
          "type": "object",
          "properties": {
            "method": { "enum": ["lttb", "minmax"] },
            "target": {
              "description": "the most points one series may draw; an explicit target makes the rendered line independent of any layout",
              "type": "integer",
              "minimum": 2
            },
            "width": {
              "description": "the width the derived target assumes, in CSS pixels (default 560)",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "pixelRatio": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },
    "domainPolicy": {
      "description": "domain-stability policy: a quantized sliding x window and/or pinned or step-quantized y bounds, so most streaming ticks keep the scales still",
      "type": "object",
      "properties": {
        "x": {
          "type": "object",
          "required": ["window"],
          "properties": {
            "window": { "type": "number", "exclusiveMinimum": 0 },
            "slide": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "y": {
          "anyOf": [
            { "const": "step" },
            {
              "type": "object",
              "properties": {
                "min": { "type": "number" },
                "max": { "type": "number" }
              }
            }
          ]
        }
      }
    }
  }
}
