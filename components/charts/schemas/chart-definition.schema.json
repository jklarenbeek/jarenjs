{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarenjs.github.io/schemas/chart-definition.schema.json",
  "title": "Chart definition",
  "description": "A self-contained chart definition for @jarenjs/charts compileChart: the type, presentation fields, and (inline) the data fields the type reads. Streaming callers may omit the data fields and pass data separately.",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {
      "enum": ["pie", "bar", "line", "scatter", "candlestick", "radar", "gauge", "boxplot", "heatmap", "treemap", "streamgraph", "sankey"]
    },
    "title": {
      "type": ["string", "null"]
    },
    "stream": { "$ref": "#/$defs/streamSpec" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "pie" } } },
      "then": {
        "properties": {
          "donut": {
            "description": "true for the default hole fraction, or the hole radius as a fraction of the outer radius",
            "type": ["boolean", "number"],
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          },
          "slices": {
            "type": "array",
            "items": { "$ref": "#/$defs/slice" }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "bar" } } },
      "then": {
        "properties": {
          "stacked": { "type": "boolean" },
          "log": { "type": "boolean" },
          "orient": { "enum": ["v", "h"] },
          "catLabel": { "type": ["string", "null"] },
          "valLabel": { "type": ["string", "null"] },
          "categories": {
            "type": "array",
            "items": { "type": "string" }
          },
          "series": {
            "type": "array",
            "items": { "$ref": "#/$defs/barSeries" }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "line" } } },
      "then": {
        "properties": {
          "x": { "enum": ["linear", "time"] },
          "log": { "type": "boolean" },
          "markers": { "type": "boolean" },
          "xLabel": { "type": ["string", "null"] },
          "yLabel": { "type": ["string", "null"] },
          "series": {
            "type": "array",
            "items": { "$ref": "#/$defs/lineSeries" }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "candlestick" } } },
      "then": {
        "properties": {
          "xLabel": { "type": ["string", "null"] },
          "yLabel": { "type": ["string", "null"] },
          "candles": {
            "type": "array",
            "items": { "$ref": "#/$defs/candle" }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "scatter" } } },
      "then": {
        "properties": {
          "xLog": { "type": "boolean" },
          "yLog": { "type": "boolean" },
          "refY": { "type": "number" },
          "refLabel": { "type": ["string", "null"] },
          "xLabel": { "type": ["string", "null"] },
          "yLabel": { "type": ["string", "null"] },
          "points": {
            "type": "array",
            "items": { "$ref": "#/$defs/point" }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "radar" } } },
      "then": {
        "properties": {
          "max": { "type": "number", "exclusiveMinimum": 0 },
          "axes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "series": {
            "type": "array",
            "items": { "$ref": "#/$defs/valueSeries" }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "gauge" } } },
      "then": {
        "properties": {
          "value": { "type": "number" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "unit": { "type": ["string", "null"] },
          "tone": { "$ref": "#/$defs/tone" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "boxplot" } } },
      "then": {
        "properties": {
          "catLabel": { "type": ["string", "null"] },
          "valLabel": { "type": ["string", "null"] },
          "boxes": {
            "type": "array",
            "items": { "$ref": "#/$defs/box" }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "heatmap" } } },
      "then": {
        "properties": {
          "log": { "type": "boolean" },
          "xLabel": { "type": ["string", "null"] },
          "yLabel": { "type": ["string", "null"] },
          "xLabels": {
            "type": "array",
            "items": { "type": "string" }
          },
          "yLabels": {
            "type": "array",
            "items": { "type": "string" }
          },
          "values": {
            "description": "values[yi][xi], row-major from the top row; null marks a missing cell",
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "treemap" } } },
      "then": {
        "properties": {
          "aspect": { "type": "number", "exclusiveMinimum": 0 },
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/treemapItem" }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "streamgraph" } } },
      "then": {
        "properties": {
          "xLabel": { "type": ["string", "null"] },
          "xs": {
            "type": "array",
            "items": { "type": "number" }
          },
          "series": {
            "type": "array",
            "items": { "$ref": "#/$defs/valueSeries" }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "sankey" } } },
      "then": {
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "anyOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["name"],
                  "properties": { "name": { "type": "string" } }
                }
              ]
            }
          },
          "links": {
            "type": "array",
            "items": { "$ref": "#/$defs/sankeyLink" }
          }
        }
      }
    }
  ],
  "$defs": {
    "streamSpec": {
      "description": "createStreamAdapter mapping: how reader events accumulate into this chart's data",
      "type": "object",
      "properties": {
        "recordPath": {
          "type": "array",
          "items": { "type": ["string", "number"] }
        },
        "recordBoundary": { "enum": ["path", "document"] },
        "xField": { "type": "string" },
        "yField": { "type": "string" },
        "seriesField": { "type": "string" },
        "maxPoints": { "type": "integer", "minimum": 1 }
      }
    },
    "slice": {
      "type": "object",
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "number", "minimum": 0 }
      }
    },
    "tone": {
      "enum": ["win", "loss", null]
    },
    "barSeries": {
      "type": "object",
      "required": ["name", "values"],
      "properties": {
        "name": { "type": "string" },
        "values": {
          "type": "array",
          "items": { "type": ["number", "null"] }
        },
        "tone": { "$ref": "#/$defs/tone" },
        "tones": {
          "type": "array",
          "items": { "$ref": "#/$defs/tone" }
        }
      }
    },
    "lineSeries": {
      "type": "object",
      "required": ["name", "points"],
      "properties": {
        "name": { "type": "string" },
        "points": {
          "type": "array",
          "items": { "$ref": "#/$defs/point" }
        }
      }
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "tone": { "$ref": "#/$defs/tone" }
      }
    },
    "candle": {
      "type": "object",
      "required": ["t", "open", "high", "low", "close"],
      "properties": {
        "t": { "type": "number" },
        "open": { "type": "number" },
        "high": { "type": "number" },
        "low": { "type": "number" },
        "close": { "type": "number" }
      }
    },
    "valueSeries": {
      "description": "a named series of index-aligned values (radar axes / streamgraph samples)",
      "type": "object",
      "required": ["name", "values"],
      "properties": {
        "name": { "type": "string" },
        "values": {
          "type": "array",
          "items": { "type": ["number", "null"] }
        }
      }
    },
    "box": {
      "description": "one boxplot category: raw samples in `values`, or a precomputed five-number summary",
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": "string" },
        "values": {
          "type": "array",
          "items": { "type": ["number", "null"] }
        },
        "min": { "type": "number" },
        "q1": { "type": "number" },
        "med": { "type": "number" },
        "q3": { "type": "number" },
        "max": { "type": "number" },
        "outliers": {
          "type": "array",
          "items": { "type": "number" }
        }
      },
      "anyOf": [
        { "required": ["values"] },
        { "required": ["min", "q1", "med", "q3", "max"] }
      ]
    },
    "treemapItem": {
      "type": "object",
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "sankeyLink": {
      "description": "a flow from source to target; endpoints are node names or node indexes",
      "type": "object",
      "required": ["source", "target", "value"],
      "properties": {
        "source": { "type": ["string", "integer"] },
        "target": { "type": ["string", "integer"] },
        "value": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
