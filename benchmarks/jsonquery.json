ta":28}},{"scenario":"singular","document":"bookstore (10000 books, 4333 ratings)","engines":{"jaren":89.41,"fontoxpath":4753,"jsonata":3720},"iterations":{"jaren":7690662,"fontoxpath":33467,"jsonata":137788}},{"scenario":"filter","document":"bookstore (10000 books, 4333 ratings)","engines":{"jaren":1406000,"fontoxpath":314500000,"jsonata":65870000},"iterations":{"jaren":588,"fontoxpath":7,"jsonata":7}},{"scenario":"join","document":"bookstore (10000 books, 4333 ratings)","engines":{},"iterations":{},"capped":1000},{"scenario":"group","document":"bookstore (10000 books, 4333 ratings)","engines":{"jaren":2720000,"fontoxpath":null,"jsonata":39530000},"iterations":{"jaren":252,"jsonata":7}},{"scenario":"reshape","document":"bookstore (10000 books, 4333 ratings)","engines":{"jaren":3708000,"fontoxpath":384700000,"jsonata":116500000},"iterations":{"jaren":210,"fontoxpath":7,"jsonata":7}}],"compile":{"sources":["singular","filter","join","reshape"],"iterations":100,"results":{"jaren":29140,"fontoxpath":469600,"jsonata":71280}},"scenarios":[{"key":"singular","title":"singular access","description":"Bind one book, return its title — the degenerate FLWOR on-ramp and the pattern of a $data-style lookup.","sources":{"fontoxpath":"$doc?store?book?3?title","jaren":"{\"$let\":{\"b\":\"$.store.book[2]\"},\"$return\":\"$b.title\"}","jsonata":"store.book[2].title"}},{"key":"filter","title":"filter + project (spec A.2)","description":"Select the books under $10, order them by price, and project title/price objects.","sources":{"fontoxpath":"for $b in $doc?store?book?*\n  where $b?price lt 10\n  order by $b?price\n  return map { \"title\": $b?title, \"price\": $b?price }","jaren":"{\"$for\":{\"b\":\"$.store.book[*]\"},\"$where\":{\"$lt\":[\"$b.price\",10]},\"$orderby\":\"$b.price\",\"$return\":{\"title\":\"$b.title\",\"price\":\"$b.price\"}}","jsonata":"store.book[price < 10]^(price).{ \"title\": title, \"price\": price }"}},{"key":"join","title":"join (spec A.3)","description":"Correlate books with a ratings array on isbn. Jaren recognizes the uncorrelated equijoin and answers it from a hash table, so it is O(n+m) where the competitors run a naive O(n·m) nested loop — read the ratio here as a different algorithm, not a faster engine. Capped at 1,000 books, because raising it would grow their cost quadratically and Jaren's linearly.","sources":{"fontoxpath":"for $b in $doc?store?book?*, $r in $doc?ratings?*\n  where $b?isbn = $r?isbn\n  order by $b?price\n  return map { \"title\": $b?title, \"stars\": $r?stars }","jaren":"{\"$for\":{\"b\":\"$.store.book[*]\",\"r\":\"$.ratings[*]\"},\"$where\":{\"$eq\":[\"$b.isbn\",\"$r.isbn\"]},\"$orderby\":\"$b.price\",\"$return\":{\"title\":\"$b.title\",\"stars\":\"$r.stars\"}}","jsonata":"(store.book^(price))@$b.$$.ratings@$r[$b.isbn = $r.isbn].{ \"title\": $b.title, \"stars\": $r.stars }"}},{"key":"group","title":"group + aggregate (spec A.4)","description":"Group books by category and compute count and average price per genre. fontoxpath does not implement the XQuery group by clause.","sources":{"jaren":"{\"$for\":{\"b\":\"$.store.book[*]\"},\"$groupby\":{\"genre\":\"$b.category\"},\"$return\":{\"genre\":\"$genre\",\"count\":{\"$count\":\"$b\"},\"avg\":{\"$avg\":\"$b.price\"}}}","jsonata":"(\n  store.book{ category: { \"count\": $count($), \"avg\": $average($.price) } }\n  ~> $each(function($v, $k) { { \"genre\": $k, \"count\": $v.count, \"avg\": $v.avg } })\n)"}},{"key":"reshape","title":"deep reshape","description":"Rebuild the store as a catalog: computed labels, nested pricing objects, and a bicycle summary in one constructor document.","sources":{"fontoxpath":"map { \"catalog\": array { for $b in $doc?store?book?*\n          return map { \"id\": ($b?isbn, $b?title)[1],\n                       \"label\": concat($b?title, \" by \", $b?author),\n                       \"pricing\": map { \"list\": $b?price,\n                                        \"discounted\": $b?price * 0.9 } } },\n        \"bike\": map { \"color\": $doc?store?bicycle?color } }","jaren":"{\"catalog\":[{\"$for\":{\"b\":\"$.store.book[*]\"},\"$return\":{\"id\":{\"$default\":[\"$b.isbn\",\"$b.title\"]},\"label\":{\"$concat\":[\"$b.title\",\" by \",\"$b.author\"]},\"pricing\":{\"list\":\"$b.price\",\"discounted\":{\"$mul\":[\"$b.price\",0.9]}}}}],\"bike\":{\"color\":\"$.store.bicycle.color\"}}","jsonata":"{\n  \"catalog\": [store.book.{ \"id\": [isbn, title][0],\n                           \"label\": title & \" by \" & author,\n                           \"pricing\": { \"list\": price, \"discounted\": price * 0.9 } }],\n  \"bike\": { \"color\": store.bicycle.color } }"}}],"firstCalls":{"operation":"one query evaluation","counts":[1000,10000],"processes":3,"tables":[{"title":"First 1,000 calls in a fresh process — one query evaluation","columns":["Jaren","fontoxpath@3.34.0","jsonata@2.2.1"],"rows":[{"name":"singular access, 4 books","results":[2178,19180,8939]},{"name":"filter + project (A.2), 4 books","results":[4739,58790,33730]},{"name":"group + aggregate (A.4), 4 books","results":[7662,null,58770]}]},{"title":"First 10,000 calls in a fresh process — one query evaluation","columns":["Jaren","fontoxpath@3.34.0","jsonata@2.2.1"],"rows":[{"name":"singular access, 4 books","results":[360.2,7079,4928]},{"name":"filter + project (A.2), 4 books","results":[1789,30900,19410]},{"name":"group + aggregate (A.4), 4 books","results":[3010,null,42160]}]}]}}