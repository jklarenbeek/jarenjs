# Local secrets and model selection for the live AI tiers.
#
# Copy to `.env` and fill in. `.env` is gitignored; THIS file is committed and
# must never contain a real key.
#
#   cp .env.example .env
#
# Loading: Node reads it natively — no dotenv dependency (the suite ships zero
# runtime dependencies outside @jarenjs/*). Entry points that support a live
# tier are run with:
#
#   node --env-file-if-exists=.env benchmark/long-horizon.js --live
#   node --env-file-if-exists=.env benchmark/long-horizon.js --authoring --live
#   node --env-file-if-exists=.env benchmark/long-horizon.js --hierarchical --live
# Authoring compares JAREN_AI_MODEL and JAREN_AI_MODEL_STRONG on identical tasks.
# --profiles PATH accepts host routes with name, provider, model, optional keyEnv,
# providerVersion, deadlineMs and sampling. Credential values never belong there.
#
# `--env-file-if-exists` is deliberate: with no `.env` present Node prints a
# notice and continues, so keyless CI runs the offline tier instead of failing.
# Every live tier is OPT-IN and skips with a stated reason when the key is
# absent — an unset variable here never breaks a run.


# ─── OpenRouter ──────────────────────────────────────────────────────────────

# Your OpenRouter API key (https://openrouter.ai/keys). This name because the
# website's e2e suite already reads OPENROUTER_AI_KEY for its live AI test, so
# one variable covers both. `OR_KEY` is accepted as an alias.
OPENROUTER_AI_KEY=sk-or-v1-...


# ─── Which provider the live tiers talk to ───────────────────────────────────

# One of: openrouter | ollama | lmstudio | custom
# The local runtimes need no key; `custom` needs JAREN_AI_BASE_URL.
JAREN_AI_PROVIDER=openrouter

# Only for `custom`, or to override a local runtime's default URL.
# Ollama defaults to http://localhost:11434/v1, LM Studio to
# http://localhost:1234/v1 — a bare host:port is normalized, so
# `http://localhost:11434` works as-is.
# JAREN_AI_BASE_URL=


# ─── Models ──────────────────────────────────────────────────────────────────

# The cheap tier. This is the DEFAULT for live measurement runs: the honest
# question is whether a small model can drive these paths, so benchmarking only
# a frontier model would flatter the result.
JAREN_AI_MODEL=google/gemini-3.7-flash

# A stronger model, used only where a measurement shows the cheap tier cannot
# carry the task (and where that finding is published beside the win).
JAREN_AI_MODEL_STRONG=z-ai/glm-5.3

# The embedding model for `benchmark/retrieval.js --live`: the ranked recall
# row is re-scored through the provider's `/embeddings` wire with this model
# (OpenRouter serves e.g. openai/text-embedding-3-small; Ollama and LM Studio
# serve whatever embedding model is pulled). Unset, the live tier skips with
# that reason and the deterministic table is the whole run.
JAREN_AI_EMBED_MODEL=baai/bge-m3


# ─── Spend guards for live runs ──────────────────────────────────────────────

# Live tiers cost real money and recursive paths multiply calls (depth × fan-out
# is multiplicative). These are hard ceilings, not hints: a run that would
# exceed one stops with a named reason and keeps whatever partial work it has.

# Max model calls in a single live run, counted across every depth.
JAREN_AI_MAX_CALLS=200

# Max concurrent sub-calls in a fan-out.
JAREN_AI_MAX_CONCURRENCY=4

# Trials per benchmark row. More trials, tighter error bars, higher spend.
JAREN_AI_TRIALS=3


# ─── PostgreSQL, for the @jarenjs/db portability corpus ──────────────────────

# The disposable endpoint the live half of the model-portability suite runs
# against. Unset, every live case skips by name and the deterministic dialect,
# driver and introspection tests — which may never skip — still run.
#
# `npm run postgres:up` builds and starts the container in `docker/postgres`
# (PostGIS with pgvector, no volume, dropped whole by `npm run postgres:down`)
# and publishes exactly this URL with the compose defaults.
#
# The suite creates and drops its own schema per run; the role it connects as
# needs CREATE on the database and nothing more.
# JAREN_PG_URL=postgres://jaren:jaren@127.0.0.1:55432/jaren
