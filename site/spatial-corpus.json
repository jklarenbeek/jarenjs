rue},{"name":"geo-parse/point","note":"","documents":[{"w":"POINT (4.9041 52.3676)"}],"query":{"$for":{"doc":"$[*]"},"$return":{"$geo-parse":"$doc.w"}},"expected":{"type":"Point","coordinates":[4.9041,52.3676]}},{"name":"geo-parse/polygon","note":"the shape every ST_AsText emits","documents":[{"w":"POLYGON ((4 52, 5 52, 5 53, 4 53, 4 52))"}],"query":{"$for":{"doc":"$[*]"},"$return":{"$geo-parse":"$doc.w"}},"expected":{"type":"Polygon","coordinates":[[[4,52],[5,52],[5,53],[4,53],[4,52]]]}},{"name":"geo-parse/multipolygon","note":"","documents":[{"w":"MULTIPOLYGON (((0 0, 1 0, 1 1, 0 0)), ((5 5, 6 5, 6 6, 5 5)))"}],"query":{"$for":{"doc":"$[*]"},"$return":{"$geo-parse":"$doc.w"}},"expected":{"type":"MultiPolygon","coordinates":[[[[0,0],[1,0],[1,1],[0,0]]],[[[5,5],[6,5],[6,6],[5,5]]]]}},{"name":"geo-parse/geometrycollection","note":"geometries, not coordinates","documents":[{"w":"GEOMETRYCOLLECTION (POINT (1 2), LINESTRING (0 0, 1 1))"}],"query":{"$for":{"doc":"$[*]"},"$return":{"$geo-parse":"$doc.w"}},"expected":{"type":"GeometryCollection","geometries":[{"type":"Point","coordinates":[1,2]},{"type":"LineString","coordinates":[[0,0],[1,1]]}]}},{"name":"geo-parse/empty-is-not-null","note":"an empty coordinate array: unparseable and validly empty are different answers","documents":[{"w":"POINT EMPTY"}],"query":{"$for":{"doc":"$[*]"},"$return":{"$geo-parse":"$doc.w"}},"expected":{"type":"Point","coordinates":[]}},{"name":"geo-parse/the-measure-dimension-is-dropped","note":"Z is an altitude and is kept; M is a measure and has no place in a GeoJSON position","documents":[{"w":"POINT ZM (1 2 3 4)"}],"query":{"$for":{"doc":"$[*]"},"$return":{"$geo-parse":"$doc.w"}},"expected":{"type":"Point","coordinates":[1,2,3]}},{"name":"geo-parse/malformed","note":"an open ring is not WKT — empty, not an error","documents":[{"w":"POLYGON ((0 0, 4 0, 4 4, 1 1))"}],"query":{"$for":{"doc":"$[*]"},"$return":{"$geo-parse":"$doc.w"}},"empty":true},{"name":"geo-parse/not-one-of-the-seven-tags","