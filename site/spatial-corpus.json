ction","note":"no positions is not the same as a non-finite one: this still measures","documents":[{"g":{"type":"FeatureCollection","features":[]}}],"query":{"$for":{"doc":"$[*]"},"$return":{"$area":"$doc.g"}},"expected":0},{"name":"area/collection-ignores-its-points","note":"the sum over the surfaces only","documents":[{"g":{"type":"FeatureCollection","features":[{"type":"Feature","properties":{"name":"region"},"geometry":{"type":"Polygon","coordinates":[[[4,52],[5,52],[5,53],[4,53],[4,52]]]}},{"type":"Feature","properties":null,"geometry":{"type":"Point","coordinates":[4.9041,52.3676]}}]}}],"query":{"$for":{"doc":"$[*]"},"$return":{"$area":"$doc.g"}},"expected":7526841324.975262},{"name":"length/linestring","note":"metres","documents":[{"g":{"type":"LineString","coordinates":[[4,52],[5,52],[5,53]]}}],"query":{"$for":{"doc":"$[*]"},"$return":{"$length":"$doc.g"}},"expected":179653.06781959327},{"name":"length/ring-perimeter","note":"","documents":[{"g":{"type":"Polygon","coordinates":[[[4,52],[5,52],[5,53],[4,53],[4,52]]]}}],"query":{"$for":{"doc":"$[*]"},"$return":{"$length":"$doc.g"}},"expected":357766.4760955728},{"name":"length/a-point-has-no-length","note":"","documents":[{"g":[4.9041,52.3676]}],"query":{"$for":{"doc":"$[*]"},"$return":{"$length":"$doc.g"}},"expected":0},{"name":"centroid/polygon","note":"the mean of the positions, NOT the area-weighted centre of mass","documents":[{"g":{"type":"Polygon","coordinates":[[[4,52],[5,52],[5,53],[4,53],[4,52]]]}}],"query":{"$for":{"doc":"$[*]"},"$return":{"$centroid":"$doc.g"}},"expected":[4.4,52.4]},{"name":"centroid/multipoint","note":"","documents":[{"g":{"type":"MultiPoint","coordinates":[[0,0],[2,0],[1,3]]}}],"query":{"$for":{"doc":"$[*]"},"$return":{"$centroid":"$doc.g"}},"expected":[1,1]},{"name":"centroid/empty-collection","note":"no positions, no mean","documents":[{"g":{"type":"FeatureCollection","features":[]}}],"query":{"$for":{"doc":"$[*]"},"$return":{"$centroid":"$doc.g"}},"empty":true},{"name":"filte