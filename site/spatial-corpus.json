r":{"c":"$doc.cities[*]"},"$where":{"$within":["$c.at","$r.shape"]},"$return":"$c.name"}]}}},"expected":[{"id":"nl","inside":["Amsterdam"]},{"id":"far","inside":[]}]},{"name":"geohash/encode-default-precision","note":"precision 9 unless asked otherwise","documents":[{"at":[4.9041,52.3676]}],"query":{"$for":{"doc":"$[*]"},"$return":{"$geohash":["$doc.at"]}},"expected":"u173zt5p3"},{"name":"geohash/encode-precision-5","note":"","documents":[{"at":[4.9041,52.3676]}],"query":{"$for":{"doc":"$[*]"},"$return":{"$geohash":["$doc.at",5]}},"expected":"u173z"},{"name":"geohash/a-shape-is-its-centroid","note":"","documents":[{"g":{"type":"Polygon","coordinates":[[[4,52],[5,52],[5,53],[4,53],[4,52]]]}}],"query":{"$for":{"doc":"$[*]"},"$return":{"$geohash":["$doc.g",3]}},"expected":"u17"},{"name":"geohash/at-the-pole","note":"the top-edge cell, not an error","documents":[{"at":[0,90]}],"query":{"$for":{"doc":"$[*]"},"$return":{"$geohash":["$doc.at",12]}},"expected":"upbpbpbpbpbp"},{"name":"geohash-bounds/a-cell-becomes-a-polygon","note":"the crossing back: a cell string becomes a value the rest of the family measures","documents":[{"c":"u173z"}],"query":{"$for":{"doc":"$[*]"},"$return":{"$geohash-bounds":"$doc.c"}},"expected":{"type":"Polygon","coordinates":[[[4.8779296875,52.3388671875],[4.921875,52.3388671875],[4.921875,52.3828125],[4.8779296875,52.3828125],[4.8779296875,52.3388671875]]]}},{"name":"geohash-bounds/round-trips-through-its-own-centre","note":"encode(bounds(c)) === c — the round trip $geohash alone could not close","documents":[{"c":"u173z"}],"query":{"$for":{"doc":"$[*]"},"$return":{"$geohash":[{"$geohash-bounds":"$doc.c"},5]}},"expected":"u173z"},{"name":"geohash-bounds/contains-the-point-it-came-from","note":"","documents":[{"at":[4.9041,52.3676]}],"query":{"$for":{"doc":"$[*]"},"$return":{"$within":["$doc.at",{"$geohash-bounds":{"$geohash":["$doc.at",7]}}]}},"expected":true},{"name":"geohash-bounds/outside-the-alphabet","note":"a, i, l and o are not in the bas