{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Successful labelled retrieval and refinement-pressure scorecards",
  "type": "object",
  "required": ["schemaVersion", "instrument", "date", "environment", "dataset", "embedding", "config", "bars"],
  "properties": {
    "schemaVersion": {"const": 1},
    "instrument": {"enum": ["recall-quality", "refinement-pressure"]},
    "date": {"type": "string", "minLength": 1},
    "environment": {"type": "object", "required": ["node", "platform", "arch", "cpu"]},
    "dataset": {"type": "object", "required": ["id", "hash"], "properties": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "embedding": {"type": "object", "required": ["model", "dims", "class"], "properties": {
      "model": {"type": "string", "minLength": 1},
      "dims": {"type": "integer", "minimum": 1},
      "class": {"enum": ["hash", "scripted", "live"]}
    }},
    "config": {"type": "object", "required": ["seed", "scope"]},
    "bars": {"type": "object"}
  },
  "definitions": {
    "metric": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "metrics": {"type": "object", "required": ["recall", "mrr", "ndcg10"], "properties": {
      "recall": {"type": "object", "required": ["1", "5", "10"], "properties": {
        "1": {"$ref": "#/definitions/metric"}, "5": {"$ref": "#/definitions/metric"}, "10": {"$ref": "#/definitions/metric"}
      }},
      "mrr": {"$ref": "#/definitions/metric"}, "ndcg10": {"$ref": "#/definitions/metric"}
    }}
  },
  "allOf": [
    {
      "if": {"properties": {"instrument": {"const": "recall-quality"}}},
      "then": {"required": ["rows", "annDecision"], "properties": {
        "dataset": {"required": ["datasetClass", "source", "license", "version", "documents", "queries", "files"],
          "properties": {"datasetClass": {"enum": ["authored", "synthetic", "real-language"]}}},
        "rows": {"type": "array", "minItems": 1, "items": {"allOf": [
          {"$ref": "#/definitions/metrics"},
          {"required": ["size", "policy", "datasetId", "datasetClass", "embeddingClass", "model", "dims", "latencyMs", "rankings"], "properties": {
            "size": {"type": "integer", "minimum": 1},
            "datasetClass": {"enum": ["authored", "synthetic", "real-language"]},
            "embeddingClass": {"enum": ["hash", "scripted", "live", "none"]},
            "rankings": {"type": "array", "items": {"type": "object", "required": ["queryId", "ids"], "properties": {
              "queryId": {"type": "string"}, "ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
            }}}
          }}
        ]}}
      }}
    },
    {
      "if": {"properties": {"instrument": {"const": "refinement-pressure"}}},
      "then": {"required": ["results", "similarities", "proposals"], "properties": {
        "dataset": {"required": ["class", "license"], "properties": {"class": {"const": "authored"}}},
        "proposals": {"const": "scripted-labelled"},
        "results": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["policy", "waves", "decision"], "properties": {
          "waves": {"type": "array", "minItems": 1, "items": {"allOf": [
            {"$ref": "#/definitions/metrics"},
            {"required": ["wave", "proposed", "records", "duplicates", "bytes", "snapshotBytes", "conflictRetention", "complementRetention"], "properties": {
              "conflictRetention": {"$ref": "#/definitions/metric"}, "complementRetention": {"$ref": "#/definitions/metric"}
            }}
          ]}}
        }}}
      }}
    }
  ]
}
