      "query": {
        "$for": {
          "i": "$.Item[*]"
        },
        "$where": {
          "$eq": [
            "$i.sku",
            "$ids[*]"
          ]
        },
        "$orderby": [
          "$i.id"
        ],
        "$return": "$i.id"
