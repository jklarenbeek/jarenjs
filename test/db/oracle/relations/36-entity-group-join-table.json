{
 "group": "36 entity group joins through a join table",
 "model": {
  "$model": "0.1",
  "entities": {
   "Person": {
    "schema": {
     "type": "object",
     "required": [
      "id"
     ],
     "properties": {
      "id": {
       "type": "string",
       "x-entity": {
        "key": true
       }
      },
      "name": {
       "type": "string"
      },
      "age": {
       "type": "integer"
      },
      "tags": {
       "x-entity": {
        "relation": {
         "to": "Tag",
         "many": true
        }
       }
      }
     }
    }
   },
   "Tag": {
    "schema": {
     "type": "object",
     "required": [
      "name"
     ],
     "properties": {
      "name": {
       "type": "string",
       "x-entity": {
        "key": true
       }
      },
      "weight": {
       "type": "integer"
      }
     }
    }
   }
  }
 },
 "documents": {
  "Person": [
   {
    "id": "p1",
    "name": "ada",
    "age": 30
   },
   {
    "id": "p2",
    "name": "lin"
   },
   {
    "id": "p3",
    "name": "ada",
    "age": 12
   },
   {
    "id": "p4",
    "name": "mo",
    "age": 50
   }
  ],
  "Tag": [
   {
    "name": "blue",
    "weight": 3
   },
   {
    "name": "green"
   },
   {
    "name": "red",
    "weight": 5
   }
  ]
 },
 "memberships": {
  "Person_Tag": [
   {
    "Person_key": "p1",
    "Tag_key": "blue"
   },
   {
    "Person_key": "p1",
    "Tag_key": "red"
   },
   {
    "Person_key": "p2",
    "Tag_key": "red"
   },
   {
    "Person_key": "p3",
    "Tag_key": "blue"
   },
   {
    "Person_key": "p3",
    "Tag_key": "green"
   },
   {
    "Person_key": "p3",
    "Tag_key": "red"
   }
  ]
 },
 "cases": [
  {
   "name": "tags per person through the join table",
   "query": {
    "$for": {
     "p": "$.Person[*]",
     "m": "$.Person_Tag[*]",
     "t": "$.Tag[*]"
    },
    "$where": {
     "$and": [
      {
       "$eq": [
        "$m.Person_key",
        "$p.id"
       ]
      },
      {
       "$eq": [
        "$m.Tag_key",
        "$t.name"
       ]
      }
     ]
    },
    "$groupby": {
     "who": "$p.id"
    },
    "$return": {
     "who": "$who",
     "n": {
      "$count": "$t"
     },
     "w": {
      "$sum": "$t.weight"
     }
    }
   }
  },
  {
   "name": "persons per tag through the join table, the tag bound first",
   "query": {
    "$for": {
     "t": "$.Tag[*]",
     "m": "$.Person_Tag[*]",
     "p": "$.Person[*]"
    },
    "$where": {
     "$and": [
      {
       "$eq": [
        "$m.Person_key",
        "$p.id"
       ]
      },
      {
       "$eq": [
        "$m.Tag_key",
        "$t.name"
       ]
      }
     ]
    },
    "$groupby": {
     "tag": "$t.name"
    },
    "$return": {
     "tag": "$tag",
     "n": {
      "$count": "$p"
     },
     "age": {
      "$max": "$p.age"
     }
    }
   }
  },
  {
   "name": "the join table and its owner, grouped by the owner's name",
   "query": {
    "$for": {
     "m": "$.Person_Tag[*]",
     "p": "$.Person[*]"
    },
    "$where": {
     "$eq": [
      "$m.Person_key",
      "$p.id"
     ]
    },
    "$groupby": {
     "name": "$p.name"
    },
    "$return": {
     "name": "$name",
     "n": {
      "$count": "$m"
     },
     "last": {
      "$max": "$m.Tag_key"
     }
    }
   }
  },
  {
   "name": "the join table grouped by a key of its own and joined to nothing else",
   "query": {
    "$for": {
     "m": "$.Person_Tag[*]",
     "t": "$.Tag[*]"
    },
    "$where": {
     "$eq": [
      "$m.Tag_key",
      "$t.name"
     ]
    },
    "$groupby": {
     "tag": "$m.Tag_key"
    },
    "$return": {
     "tag": "$tag",
     "n": {
      "$count": "$m"
     },
     "w": {
      "$min": "$t.weight"
     }
    }
   }
  }
 ]
}
