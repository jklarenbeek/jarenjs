 "cases": [
  {
   "name": "a sum ascending",
   "query": {
    "$for": {
     "it": "$.Item[*]"
    },
    "$groupby": {
     "g": "$it.g"
    },
    "$orderby": [
     {
      "$key": {
       "$sum": "$it.i"
      },
      "$dir": "asc"
     }
    ],
    "$return": {
     "g": "$g",
     "t": {
      "$sum": "$it.i"
     }
    }
   }
  },
