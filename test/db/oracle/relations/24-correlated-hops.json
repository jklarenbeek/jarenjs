    {"name": "a count at least a fraction", "query": [{"$for": {"it": "$.User[*]"}, "$where": {"$ge": [{"$count": {"$for": {"r1": "$.Post[*]"}, "$where": {"$eq": ["$r1.authorId", "$it.id"]}, "$return": "$r1"}}, 1.5]}, "$return": "$it.id"}]},
    {"name": "a count equal to a fraction", "query": [{"$for": {"it": "$.User[*]"}, "$where": {"$eq": [{"$count": {"$for": {"r1": "$.Post[*]"}, "$where": {"$eq": ["$r1.authorId", "$it.id"]}, "$return": "$r1"}}, 1.5]}, "$return": "$it.id"}]},
