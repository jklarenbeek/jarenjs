    {"name": "a hop ordering without the key proof", "query": [{"$for": {"it": "$.Post[*]"}, "$orderby": [{"$key": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.name", "$it.title"]}, "$return": "$r1.age"}}, {"$key": "$it.pid"}], "$return": "$it.pid"}]},
    {"name": "a hop ordering over the binding", "query": [{"$for": {"it": "$.Post[*]"}, "$orderby": [{"$key": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$return": "$r1"}}, {"$key": "$it.pid"}], "$return": "$it.pid"}]},
    {"name": "an ordering by a count", "query": [{"$for": {"it": "$.User[*]"}, "$orderby": [{"$key": {"$count": {"$for": {"r1": "$.Post[*]"}, "$where": {"$eq": ["$r1.authorId", "$it.id"]}, "$return": "$r1"}}}, {"$key": "$it.id"}], "$return": "$it.id"}]},
    {"name": "a to-one hop in the projection, a post without an author", "query": [{"$for": {"it": "$.Post[*]"}, "$return": {"title": "$it.title", "by": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$return": "$r1.name"}}}]},
    {"name": "a to-one hop in the projection, an absent member", "query": [{"$for": {"it": "$.Post[*]"}, "$return": {"pid": "$it.pid", "age": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$return": "$r1.age"}}}]},
    {"name": "a hop leaf beside a count leaf", "query": [{"$for": {"it": "$.Post[*]"}, "$return": {"pid": "$it.pid", "by": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$return": "$r1.name"}, "n": {"$count": {"$for": {"r1": "$.Review[*]"}, "$where": {"$eq": ["$r1.pid", "$it.pid"]}, "$return": "$r1"}}}}]},
    {"name": "a hop as the whole return", "query": [{"$for": {"it": "$.Post[*]"}, "$return": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$return": "$r1.name"}}]},
    {"name": "a count of a hop leaf whose member may be absent", "query": {"$count": {"$for": {"it": "$.Post[*]"}, "$return": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$return": "$r1.age"}}}},
    {"name": "a window over a hop leaf whose member may be absent", "query": [{"$subsequence": [{"$for": {"it": "$.Post[*]"}, "$return": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$return": "$r1.age"}}, 0, 2]}]},
    {"name": "a count leaf over a hop that returns a member some rows lack", "query": [{"$for": {"it": "$.Post[*]"}, "$return": {"pid": "$it.pid", "n": {"$count": {"$for": {"r1": "$.Review[*]"}, "$where": {"$eq": ["$r1.pid", "$it.pid"]}, "$return": "$r1.rating"}}}}]},
    {"name": "a count of a hop as the whole return", "query": {"$count": {"$for": {"it": "$.Post[*]"}, "$return": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$return": "$r1.name"}}}},
    {"name": "a window over a hop as the whole return", "query": [{"$subsequence": [{"$for": {"it": "$.Post[*]"}, "$return": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$return": "$r1.name"}}, 1, 2]}]},
    {"name": "a to-one hop as an array member", "query": [{"$for": {"it": "$.Post[*]"}, "$return": {"pid": "$it.pid", "who": [{"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$return": "$r1.name"}]}}]},
    {"name": "a hop leaf over a member of two types", "query": [{"$for": {"it": "$.Post[*]"}, "$return": {"pid": "$it.pid", "rank": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$return": "$r1.rank"}}}]},
    {"name": "a hop leaf with a per-item conjunct", "query": [{"$for": {"it": "$.Post[*]"}, "$return": {"pid": "$it.pid", "by": {"$for": {"r1": "$.User[*]"}, "$where": {"$and": [{"$eq": ["$r1.id", "$it.authorId"]}, {"$gt": ["$r1.age", 10]}]}, "$return": "$r1.name"}}}]},
    {"name": "a hop leaf beside a filter on a hop", "query": [{"$for": {"it": "$.Post[*]"}, "$where": {"$exists": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$return": "$r1.age"}}, "$return": {"pid": "$it.pid", "age": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$return": "$r1.age"}}}]},
    {"name": "a hop leaf without the key proof", "query": [{"$for": {"it": "$.Post[*]"}, "$return": {"pid": "$it.pid", "age": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.name", "$it.title"]}, "$return": "$r1.age"}}}]},
    {"name": "a to-many hop as an array member", "query": [{"$for": {"it": "$.User[*]"}, "$return": {"id": "$it.id", "titles": [{"$for": {"r1": "$.Post[*]"}, "$where": {"$eq": ["$r1.authorId", "$it.id"]}, "$return": "$r1.title"}]}}]},
    {"name": "a hop leaf returning the binding", "query": [{"$for": {"it": "$.Post[*]"}, "$return": {"pid": "$it.pid", "who": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$return": "$r1"}}}]},
    {"name": "two hops chained", "query": [{"$for": {"it": "$.Post[*]"}, "$return": {"pid": "$it.pid", "siblings": {"$count": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$return": {"$for": {"r2": "$.Post[*]"}, "$where": {"$eq": ["$r2.authorId", "$r1.id"]}, "$return": "$r2"}}}}}]},
    {"name": "a hop with an inner ordering", "query": [{"$for": {"it": "$.Post[*]"}, "$where": {"$exists": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$orderby": ["$r1.age"], "$return": "$r1"}}, "$return": "$it.pid"}]},
    {"name": "a hop that is not correlated", "query": [{"$for": {"it": "$.Post[*]"}, "$where": {"$exists": {"$for": {"r1": "$.User[*]"}, "$where": {"$gt": ["$r1.age", 50]}, "$return": "$r1"}}, "$return": "$it.pid"}]},
    {"name": "a hop correlated by an inequality", "query": [{"$for": {"it": "$.Post[*]"}, "$where": {"$exists": {"$for": {"r1": "$.User[*]"}, "$where": {"$lt": ["$r1.age", "$it.stars"]}, "$return": "$r1"}}, "$return": "$it.pid"}]},
    {"name": "a hop over a string foreign key and an integer key", "query": [{"$for": {"it": "$.Link[*]"}, "$where": {"$exists": {"$for": {"r1": "$.Num[*]"}, "$where": {"$eq": ["$r1.n", "$it.code"]}, "$return": "$r1"}}, "$return": "$it.lid"}]},
    {"name": "a count over a string foreign key and an integer key", "query": [{"$for": {"it": "$.Link[*]"}, "$where": {"$ge": [{"$count": {"$for": {"r1": "$.Num[*]"}, "$where": {"$eq": ["$r1.n", "$it.code"]}, "$return": "$r1"}}, 1]}, "$return": "$it.lid"}]},
    {"name": "a hop over an integer foreign key and an integer key", "query": [{"$for": {"it": "$.Link[*]"}, "$where": {"$exists": {"$for": {"r1": "$.Num[*]"}, "$where": {"$eq": ["$r1.n", "$it.num"]}, "$return": "$r1"}}, "$return": "$it.lid"}]},
    {"name": "a hop whose correlation admits null on the outer side", "query": [{"$for": {"it": "$.Link[*]"}, "$where": {"$exists": {"$for": {"r1": "$.Num[*]"}, "$where": {"$eq": ["$r1.label", "$it.alt"]}, "$return": "$r1"}}, "$return": "$it.lid"}]},
    {"name": "a hop whose correlation admits null on the inner side", "query": [{"$for": {"it": "$.Link[*]"}, "$where": {"$exists": {"$for": {"r1": "$.Num[*]"}, "$where": {"$eq": ["$r1.code", "$it.code"]}, "$return": "$r1"}}, "$return": "$it.lid"}]},
    {"name": "a group join counting the children", "query": [{"$for": {"it": "$.User[*]"}, "$let": {"g": [{"$for": {"it2": "$.Post[*]"}, "$where": {"$eq": ["$it.id", "$it2.authorId"]}, "$return": "$it2"}]}, "$return": {"id": "$it.id", "n": {"$count": "$g[*]"}}}]},
    {"name": "a group join read beyond its count", "query": [{"$for": {"it": "$.User[*]"}, "$let": {"g": [{"$for": {"it2": "$.Post[*]"}, "$where": {"$eq": ["$it.id", "$it2.authorId"]}, "$return": "$it2"}]}, "$return": {"id": "$it.id", "n": {"$count": "$g[*]"}, "titles": ["$g[*].title"]}}]},
    {"name": "a hop from a group join's fanned group", "query": [{"$for": {"it": "$.User[*]"}, "$let": {"g": [{"$for": {"it2": "$.Post[*]"}, "$where": {"$eq": ["$it.id", "$it2.authorId"]}, "$return": "$it2"}]}, "$return": {"id": "$it.id", "by": [{"$for": {"r1": "$g[*]"}, "$return": {"$for": {"r2": "$.User[*]"}, "$where": {"$eq": ["$r2.id", "$r1.authorId"]}, "$return": "$r2.name"}}]}}]},
    {"name": "a hop in a join, correlated with one binding", "query": [{"$for": {"p": "$.Post[*]", "u": "$.User[*]"}, "$where": {"$and": [{"$eq": ["$p.authorId", "$u.id"]}, {"$ge": [{"$count": {"$for": {"r1": "$.Review[*]"}, "$where": {"$eq": ["$r1.pid", "$p.pid"]}, "$return": "$r1"}}, 1]}]}, "$return": "$p.pid"}]},
    {"name": "a count correlated with the second binding of a join", "query": [{"$for": {"p": "$.Post[*]", "u": "$.User[*]"}, "$where": {"$and": [{"$eq": ["$p.authorId", "$u.id"]}, {"$ge": [{"$count": {"$for": {"r1": "$.Post[*]"}, "$where": {"$eq": ["$r1.authorId", "$u.id"]}, "$return": "$r1"}}, 2]}]}, "$return": "$p.pid"}]},
    {"name": "a hop key under an ordering in a join", "query": [{"$for": {"p": "$.Post[*]", "u": "$.User[*]"}, "$where": {"$eq": ["$p.authorId", "$u.id"]}, "$orderby": [{"$key": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$p.authorId"]}, "$return": "$r1.name"}, "$dir": "desc"}, {"$key": "$p.pid"}], "$return": "$p.pid"}]},
    {"name": "a hop leaf and a count leaf correlated with the second binding of a join", "query": [{"$for": {"p": "$.Post[*]", "u": "$.User[*]"}, "$where": {"$eq": ["$p.authorId", "$u.id"]}, "$return": {"pid": "$p.pid", "who": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$u.id"]}, "$return": "$r1.name"}, "n": {"$count": {"$for": {"r2": "$.Review[*]"}, "$where": {"$eq": ["$r2.pid", "$p.pid"]}, "$return": "$r2"}}}}]},
    {"name": "a hop in a disjunction across the bindings of a join", "query": [{"$for": {"p": "$.Post[*]", "u": "$.User[*]"}, "$where": {"$and": [{"$eq": ["$p.authorId", "$u.id"]}, {"$or": [{"$ge": [{"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$p.authorId"]}, "$return": "$r1.age"}, 40]}, {"$lt": ["$u.age", 20]}]}]}, "$return": "$p.pid"}]},
    {"name": "a sum over a hop leaf", "query": {"$sum": {"$for": {"it": "$.Post[*]"}, "$return": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$return": "$r1.age"}}}},
    {"name": "a hop in a join, correlated with both bindings", "query": [{"$for": {"p": "$.Post[*]", "u": "$.User[*]"}, "$where": {"$and": [{"$eq": ["$p.authorId", "$u.id"]}, {"$exists": {"$for": {"r1": "$.Review[*]"}, "$where": {"$and": [{"$eq": ["$r1.pid", "$p.pid"]}, {"$eq": ["$r1.rating", "$u.age"]}]}, "$return": "$r1"}}]}, "$return": "$p.pid"}]},
    {"name": "a hop beneath a grouping", "query": [{"$for": {"it": "$.Post[*]"}, "$where": {"$exists": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$return": "$r1.age"}}, "$groupby": {"a": "$it.authorId"}, "$return": {"a": "$a", "n": {"$count": "$it"}}}]},
    {"name": "a hop in a first", "query": [{"$subsequence": [{"$for": {"it": "$.Post[*]"}, "$where": {"$eq": [{"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$return": "$r1.name"}, "lin"]}, "$orderby": {"$key": "$it.pid"}, "$return": "$it.title"}, 0, 1]}]},
    {"name": "a hop filter under an offset window", "query": [{"$subsequence": [{"$for": {"it": "$.Post[*]"}, "$where": {"$exists": {"$for": {"r1": "$.User[*]"}, "$where": {"$eq": ["$r1.id", "$it.authorId"]}, "$return": "$r1"}}, "$orderby": {"$key": "$it.pid"}, "$return": "$it.pid"}, 1, 2]}]}
  ]
}
