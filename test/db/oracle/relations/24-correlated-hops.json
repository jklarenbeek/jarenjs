    {"name": "a to-many hop whose member exists", "query": [{"$for": {"it": "$.User[*]"}, "$where": {"$exists": {"$for": {"r1": "$.Post[*]"}, "$where": {"$eq": ["$r1.authorId", "$it.id"]}, "$return": "$r1.stars"}}, "$return": "$it.id"}]},
