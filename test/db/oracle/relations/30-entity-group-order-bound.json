{
 "group": "30 entity group order past the exactness bound",
 "model": {
  "$model": "0.1",
  "entities": {
   "Item": {
    "schema": {
     "type": "object",
     "required": [
      "id"
     ],
     "properties": {
      "id": {
       "type": "integer",
       "x-entity": {
        "key": true
       }
      },
      "g": {
       "type": "string",
       "x-entity": {
        "index": true
       }
      },
      "i": {
       "type": "integer",
       "x-entity": {
        "index": true
       }
      },
      "m": {
       "type": "number"
      },
      "k": {
       "type": "integer",
       "x-entity": {
        "index": true
       }
      }
     }
    }
   }
  }
 },
 "documents": {
  "Item": [
   {
    "id": 1,
    "g": "B",
    "i": 1000000000000001
   },
   {
    "id": 2,
    "g": "B",
    "i": 1000000000000001
   },
   {
    "id": 3,
    "g": "B",
    "i": 1000000000000001
   },
   {
    "id": 4,
