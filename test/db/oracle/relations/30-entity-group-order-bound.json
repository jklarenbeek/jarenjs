   },
   {
    "id": 10,
    "g": "A",
    "i": 1000000000000001
   },
   {
    "id": 11,
    "g": "A",
    "i": 1000000000000001
   },
   {
    "id": 12,
    "g": "U",
    "i": 9007199254740991
   },
   {
    "id": 13,
    "g": "U",
    "i": 2
   },
   {
    "id": 14,
    "g": "U",
    "i": -9007199254740991
   },
   {
    "id": 15,
    "g": "V",
    "i": 1
   }
  ]
 },
 "cases": [
  {
   "name": "averages that round to one double tie, descending",
   "query": {
    "$for": {
     "it": "$.Item[*]"
    },
    "$where": {
     "$or": [
      {
       "$eq": [
        "$it.g",
        "A"
       ]
      },
      {
       "$eq": [
        "$it.g",
        "B"
       ]
      }
     ]
    },
    "$groupby": {
     "g": "$it.g"
    },
    "$orderby": [
     {
      "$key": {
       "$avg": "$it.i"
      },
      "$dir": "desc"
     }
    ],
    "$return": {
     "g": "$g",
     "a": {
      "$avg": "$it.i"
     }
    }
   }
  },
  {
   "name": "averages that round to one double tie, ascending",
   "query": {
    "$for": {
     "it": "$.Item[*]"
    },
    "$where": {
