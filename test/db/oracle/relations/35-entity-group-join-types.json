 "cases": [
  {
   "name": "caps per team across three bindings",
   "query": {
    "$for": {
     "t": "$.Team[*]",
     "p": "$.Player[*]",
     "c": "$.Cap[*]"
    },
    "$where": {
     "$and": [
      {
       "$eq": [
        "$p.teamId",
        "$t.tid"
       ]
      },
      {
       "$eq": [
        "$c.plid",
        "$p.plid"
       ]
      }
     ]
    },
    "$groupby": {
     "team": "$t.name"
    },
    "$return": {
     "team": "$team",
     "n": {
      "$count": "$c"
     },
     "mins": {
      "$sum": "$c.mins"
     }
    }
   }
  },
  {
   "name": "three bindings, the middle one bound first",
   "query": {
    "$for": {
     "p": "$.Player[*]",
     "t": "$.Team[*]",
     "c": "$.Cap[*]"
    },
    "$where": {
     "$and": [
      {
       "$eq": [
        "$p.teamId",
        "$t.tid"
       ]
      },
      {
       "$eq": [
        "$c.plid",
        "$p.plid"
       ]
      }
     ]
    },
    "$groupby": {
     "team": "$t.name"
    },
    "$return": {
     "team": "$team",
     "n": {
      "$count": "$c"
     },
     "players": {
      "$count": "$p"
     }
    }
   }
  },
  {
   "name": "three bindings joined through the middle one only",
   "query": {
    "$for": {
     "t": "$.Team[*]",
     "c": "$.Cap[*]",
     "p": "$.Player[*]"
    },
    "$where": {
     "$and": [
      {
       "$eq": [
        "$p.teamId",
        "$t.tid"
       ]
      },
      {
       "$eq": [
        "$c.plid",
        "$p.plid"
       ]
      }
     ]
    },
    "$groupby": {
     "team": "$t.name"
    },
    "$return": {
     "team": "$team",
     "n": {
      "$count": "$p"
     },
     "hi": {
      "$max": "$c.mins"
     }
    }
   }
  },
  {
   "name": "a member of the same name on two bindings",
   "query": {
    "$for": {
     "t": "$.Team[*]",
     "p": "$.Player[*]"
    },
    "$where": {
     "$eq": [
      "$p.teamId",
      "$t.tid"
     ]
    },
    "$groupby": {
     "r": "$t.rank"
    },
    "$return": {
     "r": "$r",
     "pmax": {
      "$max": "$p.rank"
     },
     "tmax": {
      "$max": "$t.rank"
     },
     "n": {
      "$count": "$p"
     }
    }
   }
  },
  {
   "name": "the same member of both bindings summed beside each other",
   "query": {
    "$for": {
     "t": "$.Team[*]",
     "p": "$.Player[*]"
    },
    "$where": {
     "$eq": [
      "$p.teamId",
      "$t.tid"
     ]
    },
    "$groupby": {
     "team": "$t.name"
    },
    "$return": {
     "team": "$team",
     "ps": {
      "$sum": "$p.rank"
     },
     "ts": {
      "$sum": "$t.rank"
     },
     "pa": {
      "$avg": "$p.rank"
     },
     "ta": {
      "$avg": "$t.rank"
     }
    }
   }
  },
  {
   "name": "aggregates of a member some rows lack",
   "query": {
    "$for": {
     "t": "$.Team[*]",
     "p": "$.Player[*]"
    },
    "$where": {
     "$eq": [
      "$p.teamId",
      "$t.tid"
     ]
    },
    "$groupby": {
     "team": "$t.name"
    },
    "$return": {
     "team": "$team",
     "s": {
      "$sum": "$p.goals"
     },
     "a": {
      "$avg": "$p.goals"
     },
     "lo": {
      "$min": "$p.goals"
     },
     "hi": {
      "$max": "$p.goals"
     }
    }
   }
  },
  {
   "name": "a boolean key of the parent",
   "query": {
    "$for": {
     "t": "$.Team[*]",
     "p": "$.Player[*]"
    },
    "$where": {
     "$eq": [
      "$p.teamId",
      "$t.tid"
     ]
    },
    "$groupby": {
     "up": "$t.up"
    },
    "$return": {
     "up": "$up",
     "n": {
      "$count": "$p"
     }
    }
   }
  },
  {
   "name": "a boolean key of the child, absent for some",
   "query": {
    "$for": {
     "t": "$.Team[*]",
     "p": "$.Player[*]"
    },
    "$where": {
     "$eq": [
      "$p.teamId",
      "$t.tid"
     ]
    },
    "$groupby": {
     "ok": "$p.ok"
    },
    "$return": {
     "ok": "$ok",
     "n": {
      "$count": "$t"
     }
    }
   }
  },
  {
   "name": "strings compare by code point across bindings",
   "query": {
    "$for": {
     "t": "$.Team[*]",
     "p": "$.Player[*]"
    },
    "$where": {
     "$eq": [
      "$p.teamId",
      "$t.tid"
     ]
    },
    "$groupby": {
     "team": "$t.name"
    },
    "$return": {
     "team": "$team",
     "lo": {
      "$min": "$p.nick"
     },
     "hi": {
      "$max": "$p.nick"
     }
    }
   }
  },
  {
   "name": "a key that spans the rows of several parents",
   "query": {
    "$for": {
     "t": "$.Team[*]",
     "p": "$.Player[*]"
    },
    "$where": {
     "$eq": [
      "$p.teamId",
      "$t.tid"
     ]
    },
    "$groupby": {
     "nick": "$p.nick"
    },
    "$return": {
     "nick": "$nick",
     "n": {
      "$count": "$t"
     },
     "g": {
      "$sum": "$p.goals"
     }
    }
   }
  },
  {
   "name": "a parent's value repeated by its children passes the exactness bound",
   "query": {
    "$for": {
     "t": "$.Team[*]",
     "p": "$.Player[*]"
    },
    "$where": {
     "$eq": [
      "$p.teamId",
      "$t.tid"
     ]
    },
    "$groupby": {
     "team": "$t.name"
    },
    "$return": {
     "team": "$team",
     "s": {
      "$sum": "$t.cap"
     }
    }
   }
  },
  {
   "name": "a parent's value repeated by its children, averaged",
   "query": {
    "$for": {
     "t": "$.Team[*]",
     "p": "$.Player[*]"
    },
    "$where": {
     "$eq": [
      "$p.teamId",
      "$t.tid"
     ]
    },
    "$groupby": {
     "team": "$t.name"
    },
    "$return": {
     "team": "$team",
     "a": {
      "$avg": "$t.cap"
     }
    }
   }
  },
  {
   "name": "a self join grouped by the first player",
   "query": {
    "$for": {
     "a": "$.Player[*]",
     "b": "$.Player[*]"
    },
    "$where": {
     "$eq": [
      "$a.teamId",
      "$b.teamId"
     ]
    },
    "$groupby": {
     "nick": "$a.nick"
    },
    "$return": {
     "nick": "$nick",
     "n": {
      "$count": "$b"
     },
     "g": {
      "$sum": "$b.goals"
     }
    }
   }
  },
  {
   "name": "a disjunction across joined bindings beside the grouping",
   "query": {
    "$for": {
     "t": "$.Team[*]",
     "p": "$.Player[*]"
    },
    "$where": {
     "$and": [
      {
       "$eq": [
        "$p.teamId",
        "$t.tid"
       ]
      },
      {
       "$or": [
        {
         "$gt": [
          "$t.rank",
          1
         ]
        },
        {
         "$gt": [
          "$p.goals",
          3
         ]
        }
       ]
      }
     ]
    },
    "$groupby": {
     "team": "$t.name"
    },
    "$return": {
     "team": "$team",
     "n": {
      "$count": "$p"
     }
    }
   }
  },
  {
   "name": "an external bound inside a grouped join",
   "query": {
    "$for": {
     "t": "$.Team[*]",
     "p": "$.Player[*]"
    },
    "$where": {
     "$and": [
      {
       "$eq": [
        "$p.teamId",
        "$t.tid"
       ]
      },
      {
       "$ge": [
        "$p.goals",
        "$least"
       ]
      }
     ]
    },
    "$groupby": {
     "team": "$t.name"
    },
    "$return": {
     "team": "$team",
     "n": {
      "$count": "$p"
     }
    }
   },
   "externals": {
    "least": 2
   }
  },
  {
   "name": "a floating mean over three bindings is the engine's",
   "query": {
    "$for": {
     "t": "$.Team[*]",
     "p": "$.Player[*]",
     "c": "$.Cap[*]"
    },
    "$where": {
     "$and": [
      {
       "$eq": [
        "$p.teamId",
        "$t.tid"
       ]
      },
      {
       "$eq": [
        "$c.plid",
        "$p.plid"
       ]
      }
     ]
    },
    "$groupby": {
     "team": "$t.name"
    },
    "$return": {
     "team": "$team",
     "a": {
      "$avg": "$p.ratio"
     }
    }
   }
  },
  {
   "name": "an ordered grouping over three bindings is the engine's",
   "query": {
    "$for": {
     "t": "$.Team[*]",
     "p": "$.Player[*]",
     "c": "$.Cap[*]"
    },
    "$where": {
     "$and": [
      {
       "$eq": [
        "$p.teamId",
        "$t.tid"
       ]
      },
      {
       "$eq": [
        "$c.plid",
        "$p.plid"
       ]
      }
     ]
    },
    "$groupby": {
     "team": "$t.name"
    },
    "$orderby": [
     {
      "$key": {
       "$count": "$c"
      },
      "$dir": "desc"
     }
    ],
    "$return": {
     "team": "$team",
     "n": {
      "$count": "$c"
     }
    }
   }
  },
  {
   "name": "a third binding nothing connects is a product, and the engine groups it",
   "query": {
    "$for": {
     "t": "$.Team[*]",
     "p": "$.Player[*]",
     "c": "$.Cap[*]"
    },
    "$where": {
     "$eq": [
      "$p.teamId",
      "$t.tid"
     ]
    },
    "$groupby": {
     "team": "$t.name"
    },
    "$return": {
     "team": "$team",
     "n": {
      "$count": "$c"
     }
    }
   }
  },
  {
   "name": "a difference between the bindings refines the join beside the grouping",
   "query": {
    "$for": {
     "t": "$.Team[*]",
     "p": "$.Player[*]"
    },
    "$where": {
     "$and": [
      {
       "$eq": [
        "$p.teamId",
        "$t.tid"
       ]
      },
      {
       "$ne": [
        "$p.rank",
        "$t.rank"
       ]
      }
     ]
    },
    "$groupby": {
     "r": "$t.rank"
    },
    "$return": {
     "r": "$r",
     "n": {
      "$count": "$p"
     }
    }
   }
  }
 ]
}
