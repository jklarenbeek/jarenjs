       "type": "integer",
       "x-entity": {
        "key": true
       }
      },
      "teamId": {
       "type": "string",
       "x-entity": {
        "index": true
       }
      },
      "nick": {
       "type": "string"
      },
      "rank": {
       "type": "integer"
      },
      "goals": {
       "type": "integer"
      },
      "ok": {
       "type": "boolean"
      },
      "ratio": {
       "type": "number"
      }
     }
    }
   },
   "Cap": {
    "schema": {
     "type": "object",
     "required": [
      "cid"
     ],
     "properties": {
      "cid": {
       "type": "integer",
       "x-entity": {
        "key": true
       }
      },
      "plid": {
       "type": "integer",
       "x-entity": {
        "index": true
       }
      },
      "mins": {
       "type": "integer"
      },
      "tag": {
       "type": "string"
      }
     }
    }
   }
  }
 },
