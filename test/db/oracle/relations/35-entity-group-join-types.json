{
 "group": "35 entity group joins over three bindings",
 "model": {
  "$model": "0.1",
  "entities": {
   "Team": {
    "schema": {
     "type": "object",
     "required": [
      "tid"
     ],
     "properties": {
      "tid": {
       "type": "string",
       "x-entity": {
        "key": true
