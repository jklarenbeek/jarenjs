     },
     "$return": {
      "city": "$p.city",
      "line": "$p.bio.line"
     }
    }
   }
  },
  {
   "name": "an array constructor stays in the engine",
   "query": {
    "$distinct": {
     "$for": {
      "p": "$.Person[*]"
     },
     "$return": [
      "$p.city",
      "$p.age"
     ]
    }
   }
  },
  {
   "name": "the bare binding stays in the engine",
   "query": {
