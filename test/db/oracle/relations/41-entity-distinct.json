  },
  {
   "name": "a distinct of a joined binding with an ordering stays in the engine",
   "query": {
    "$distinct": {
     "$for": {
      "p": "$.Person[*]",
      "q": "$.Pet[*]"
     },
     "$where": {
      "$eq": [
       "$p.id",
       "$q.ownerId"
      ]
     },
     "$orderby": [
      "$q.pid"
     ],
     "$return": "$q.kind"
