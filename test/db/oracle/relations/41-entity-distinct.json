{
 "group": "entity distinct over mapped columns",
 "model": {
  "$model": "0.1",
  "entities": {
   "Person": {
    "schema": {
     "type": "object",
     "required": [
      "id"
     ],
     "properties": {
      "id": {
       "type": "string",
       "x-entity": {
        "key": true
       }
      },
      "name": {
       "type": "string"
      },
      "age": {
       "type": "integer",
       "x-entity": {
        "index": true
       }
      },
      "city": {
       "type": "string",
       "x-entity": {
        "index": true
       }
      },
      "score": {
       "type": "number"
      },
      "active": {
       "type": "boolean"
      },
      "nick": {
       "type": [
        "string",
        "null"
       ]
      },
      "bio": {
       "type": "object",
       "properties": {
        "line": {
         "type": "string"
        }
       }
      },
      "pets": {
       "x-entity": {
        "relation": {
         "to": "Pet",
         "many": true,
         "via": "ownerId",
         "onDelete": "cascade"
        }
       }
      }
     }
    }
   },
   "Pet": {
    "schema": {
     "type": "object",
     "required": [
      "pid",
      "ownerId"
     ],
     "properties": {
      "pid": {
       "type": "integer",
       "x-entity": {
        "key": true
       }
      },
      "kind": {
       "type": "string"
      },
      "weight": {
       "type": "number"
      },
      "ownerId": {
       "type": "string",
       "x-entity": {
        "index": true
       }
      }
     }
    }
   },
   "Toy": {
    "schema": {
     "type": "object",
     "required": [
      "tid"
     ],
     "properties": {
      "tid": {
       "type": "integer",
       "x-entity": {
        "key": true
       }
      },
      "name": {
       "type": "string"
      },
      "petId": {
       "type": "integer",
       "x-entity": {
        "index": true
       }
      }
     }
    }
   }
  }
 },
