   }
  },
  {
   "name": "a constructor holding the binding stays in the engine",
   "query": {
    "$distinct": {
     "$for": {
      "p": "$.Person[*]"
     },
     "$return": {
      "who": "$p",
      "city": "$p.city"
     }
    }
   }
  },
  {
   "name": "a constructor without a column stays in the engine",
   "query": {
    "$distinct": {
     "$for": {
      "p": "$.Person[*]"
     },
     "$return": {
      "k": 1
     }
    }
   }
  },
  {
   "name": "an operator inside a constructor stays in the engine",
   "query": {
    "$distinct": {
     "$for": {
      "p": "$.Person[*]"
     },
     "$return": {
      "u": {
       "$upper": "$p.name"
      }
     }
    }
   }
  },
  {
   "name": "a count of a related entity stays in the engine",
   "query": {
    "$distinct": {
     "$for": {
      "p": "$.Person[*]"
     },
     "$return": {
      "pets": {
       "$count": {
        "$for": {
         "q": "$.Pet[*]"
        },
        "$where": {
         "$eq": [
