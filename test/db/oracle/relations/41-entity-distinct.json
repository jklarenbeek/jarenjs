  {
   "name": "a window over a distinct of a join",
   "query": {
    "$subsequence": [
     {
      "$distinct": {
       "$for": {
        "p": "$.Person[*]",
        "q": "$.Pet[*]"
       },
       "$where": {
        "$eq": [
         "$p.id",
         "$q.ownerId"
        ]
       },
       "$return": {
        "city": "$p.city",
        "kind": "$q.kind"
       }
      }
     },
     1,
     2
    ]
   }
  },
  {
   "name": "a distinct of a join beside a filter on each binding",
   "query": {
    "$distinct": {
     "$for": {
      "p": "$.Person[*]",
      "q": "$.Pet[*]"
     },
     "$where": {
      "$and": [
       {
        "$eq": [
         "$p.id",
         "$q.ownerId"
        ]
       },
       {
        "$ne": [
         "$p.city",
         "utrecht"
        ]
       },
       {
        "$ne": [
         "$q.kind",
         "fish"
        ]
       }
      ]
     },
     "$return": {
      "name": "$p.name",
      "kind": "$q.kind"
     }
    }
   }
  },
  {
   "name": "a compound of columns of three joined bindings",
   "query": {
    "$distinct": {
     "$for": {
      "p": "$.Person[*]",
      "q": "$.Pet[*]",
      "r": "$.Toy[*]"
     },
     "$where": {
      "$and": [
       {
        "$eq": [
         "$p.id",
         "$q.ownerId"
        ]
       },
       {
        "$eq": [
         "$q.pid",
         "$r.petId"
        ]
       }
      ]
     },
     "$return": {
      "city": "$p.city",
      "kind": "$q.kind",
      "toy": "$r.name"
     }
    }
   }
  },
  {
   "name": "a column of the third joined binding",
   "query": {
    "$distinct": {
     "$for": {
      "p": "$.Person[*]",
      "q": "$.Pet[*]",
      "r": "$.Toy[*]"
     },
     "$where": {
      "$and": [
       {
        "$eq": [
         "$p.id",
         "$q.ownerId"
        ]
       },
       {
        "$eq": [
         "$q.pid",
         "$r.petId"
        ]
       }
      ]
     },
     "$return": "$r.name"
    }
   }
  },
  {
