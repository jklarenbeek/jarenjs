  {
   "name": "distinct n",
   "query": {
    "$distinct": {
     "$for": {
      "it": "$[*]"
     },
     "$return": "$it.n"
    }
   }
  },
  {
   "name": "distinct window n",
   "query": {
    "$subsequence": [
     {
      "$distinct": {
       "$for": {
        "it": "$[*]"
       },
       "$return": "$it.n"
      }
     },
     1,
     2
    ]
   }
  },
  {
   "name": "nullable grouping n",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$groupby": {
     "g": "$it.n"
    },
    "$return": {
     "key": "$g",
     "count": {
      "$count": "$it"
     }
    }
   }
  },
