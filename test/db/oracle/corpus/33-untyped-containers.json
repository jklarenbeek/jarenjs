   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$ne": [
      "$it.u['0']",
      "$it.u['1']"
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "two widened members by name, an order",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$le": [
      "$it.u['0']",
      "$it.u['1']"
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "two widened members by name, an equality",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$eq": [
      "$it.u['0']",
      "$it.u['1']"
     ]
    },
    "$return": "$it.id"
