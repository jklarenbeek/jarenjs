 "cases": [
  {
   "name": "a name 0 against a number",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$eq": [
      "$it.n['0']",
      7
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "a name 0 differs from a number",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$ne": [
      "$it.n['0']",
      7
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "a name 0 ordered against a number",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$gt": [
      "$it.n['0']",
      5
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "a name 0 exists",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$exists": "$it.n['0']"
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "a name 0 is empty",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$empty": "$it.n['0']"
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "a name 0 is the order",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$orderby": [
     "$it.n['0']"
    ],
    "$return": "$it.id"
   }
  },
  {
   "name": "a name 0 is the order, descending",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$orderby": [
     {
      "$key": "$it.n['0']",
      "$dir": "desc"
     }
    ],
    "$return": "$it.id"
   }
  },
  {
   "name": "an index 0 against a number",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$eq": [
      "$it.v[0]",
      7
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "an index 0 ordered against a number",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$lt": [
      "$it.v[0]",
      9
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "an index 0 exists",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$exists": "$it.v[0]"
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "an index 0 is the order",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$orderby": [
     "$it.v[0]"
    ],
    "$return": "$it.id"
   }
  },
  {
   "name": "a name 0 projected",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$exists": "$it.n['0']"
