      "$it.u[0]",
      "$it.u[1]"
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "two widened members by index, an order",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$ge": [
