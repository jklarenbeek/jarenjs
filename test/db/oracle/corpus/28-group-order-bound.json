  {
   "name": "averages that round to one double tie, descending",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$or": [
      {
       "$eq": [
        "$it.g",
        "A"
       ]
      },
      {
       "$eq": [
        "$it.g",
        "B"
       ]
      }
     ]
    },
    "$groupby": {
     "g": "$it.g"
    },
    "$orderby": [
     {
      "$key": {
       "$avg": "$it.i"
      },
      "$dir": "desc"
     }
    ],
    "$return": {
     "g": "$g",
     "a": {
      "$avg": "$it.i"
     }
    }
   }
  },
