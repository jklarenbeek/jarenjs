 "cases": [
  {
   "name": "count all",
   "query": {
    "$count": {
     "$for": {
      "it": "$[*]"
     },
     "$return": "$it"
    }
   }
  },
  {
   "name": "count filtered",
   "query": {
    "$count": {
     "$for": {
      "it": "$[*]"
     },
     "$where": {
      "$gt": [
       "$it.n",
       15
      ]
     },
     "$return": "$it"
    }
   }
  },
  {
   "name": "count empty",
   "query": {
    "$count": {
     "$for": {
      "it": "$[*]"
     },
     "$where": {
      "$gt": [
       "$it.n",
       999
      ]
     },
     "$return": "$it"
    }
   }
  },
  {
   "name": "sum with holes",
   "query": {
    "$sum": {
     "$for": {
      "it": "$[*]"
     },
     "$return": "$it.n"
    }
   }
  },
  {
   "name": "sum over empty is zero",
   "query": {
    "$sum": {
     "$for": {
      "it": "$[*]"
     },
     "$where": {
      "$gt": [
       "$it.n",
       999
      ]
     },
     "$return": "$it.n"
    }
   }
  },
  {
