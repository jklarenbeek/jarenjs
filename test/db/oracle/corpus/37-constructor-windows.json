  {
   "name": "a window over a default constructor",
   "query": {
    "$subsequence": [
     {
      "$for": {
       "it": "$[*]"
      },
      "$orderby": [
       "$it.id"
      ],
      "$return": {
       "id": "$it.id",
       "v": {
        "$default": [
         "$it.n",
         -1
        ]
       }
      }
     },
     1,
     3
    ]
   }
  },
  {
