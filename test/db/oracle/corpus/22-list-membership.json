   "n": 10,
   "s": "ada",
   "f": 1.5,
   "b": true,
   "o": {
    "k": 1
   },
   "u": "text"
  },
  {
   "id": "b",
   "n": 20,
   "s": "kid",
   "f": -2.25,
   "b": false,
   "u": 7
  },
  {
   "id": "c",
   "n": 30,
   "s": "lin",
   "o": {
    "k": 3
   },
   "u": null
  },
  {
   "id": "d",
   "s": "zed",
   "f": 0.0,
   "u": true
  },
  {
   "id": "e",
   "n": 20,
   "u": [
    1,
    2
   ]
  },
  {
   "id": "f",
   "s": "",
   "f": 0,
   "u": {
    "k": 1
   }
  },
  {
   "id": "g",
   "n": -5,
   "s": "ada",
   "u": "7"
  },
  {
   "id": "h",
   "n": 10,
   "s": "$x",
   "u": false
  },
  {
   "id": "i"
  },
  {
   "id": "j",
   "n": 7,
   "s": "Ada",
   "o": {
    "k": 4
   },
   "u": 1
  }
 ],
 "cases": [
  {
   "name": "a string list on a typed member",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$eq": [
      "$it.s",
      {
       "$seq": [
        "ada",
        "lin",
        "nobody"
       ]
      }
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "the list first, the member second",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$eq": [
      {
       "$seq": [
        "zed",
        "kid"
       ]
      },
      "$it.s"
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "a number list with a duplicate, an integer and a real",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$eq": [
      "$it.n",
      {
       "$seq": [
        10,
        30,
        30,
        20.5,
        20.0,
        99
       ]
      }
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "a number list against a real member, zero both ways",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$eq": [
      "$it.f",
      {
       "$seq": [
        1.5,
        0,
        -2.25
       ]
      }
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "a cross-type list on a typed member matches nothing",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$eq": [
      "$it.n",
      {
       "$seq": [
        "10",
        "ada"
       ]
      }
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "mixed kinds on an untyped member, a null and a boolean included",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$eq": [
      "$it.u",
      {
       "$seq": [
        "text",
        7,
        null,
        true
       ]
      }
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "false alone",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$eq": [
      "$it.u",
      {
       "$seq": [
        false
       ]
      }
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "an array- or object-valued member against scalars",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$eq": [
      "$it.u",
      {
       "$seq": [
        1,
        2,
        "k"
       ]
      }
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "an empty list matches nothing",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$eq": [
      "$it.s",
      {
       "$seq": []
      }
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "an absent member is false, and its negation true",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$not": {
      "$eq": [
       "$it.s",
       {
        "$seq": [
         "ada",
         ""
        ]
       }
      ]
     }
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "a nested member",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$eq": [
      "$it.o.k",
      {
       "$seq": [
        3,
        4
       ]
      }
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "a dollar-leading string literal",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$eq": [
      "$it.s",
      {
       "$seq": [
        "$$x",
        "zed"
       ]
      }
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "membership is case-sensitive",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$eq": [
      "$it.s",
      {
       "$seq": [
        "ADA",
        "Ada"
       ]
      }
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "an or of equalities on one member folds",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$or": [
      {
       "$eq": [
        "$it.s",
        "ada"
       ]
      },
      {
       "$eq": [
        "lin",
        "$it.s"
       ]
      },
      {
       "$eq": [
        "$it.s",
        "zed"
       ]
      }
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "an or of equalities folds with a null and a number",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$or": [
      {
       "$eq": [
        "$it.u",
        "text"
       ]
      },
      {
       "$eq": [
        "$it.u",
        null
       ]
      },
      {
       "$eq": [
        "$it.u",
        7
       ]
      }
     ]
    },
    "$return": "$it.id"
   }
  },
  {
   "name": "an or over two members does not fold",
   "query": {
    "$for": {
     "it": "$[*]"
    },
    "$where": {
     "$or": [
      {
       "$eq": [
        "$it.s",
