  "tickInterval": {
    "grammar": "^([1-9]\\d*)(millisecond|second|minute|hour|day|week|month)$",
    "units": ["millisecond", "second", "minute", "hour", "day", "week", "month"],
    "examples": ["1day", "2week", "12hour", "1month"],
    "rejects": ["0day", "1days", "day", "-1day", "1year", "1.5day", "01day"]
  },
  "duration": {
