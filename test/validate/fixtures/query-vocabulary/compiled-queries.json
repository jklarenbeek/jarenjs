{
  "description": "$query documents collected from the test/validate suite. Each compiles as a query (the one free external is refused by the keyword, not by the query compiler), and the Jaren dialect meta-schema must accept each.",
  "queries": [
    "$.approved",
    "$.ok",
    "$.xs[*]",
    false,
    {"$add": ["$.a", 1]},
    {"$and": [{"$exists": "$root"}, {"$exists": "$path"}]},
    {"$and": [{"$le": ["$.lo", "$.hi"]}, {"$eq": ["$path", {"$concat": ["/pairs/", {"$string": "$.i"}]}]}]},
    {"$assert": ["$.a", {"type": "string"}]},
    {"$eq": ["$.currency", "$root.currency"]},
    {"$eq": ["$.total", {"$sum": "$.lines[*].amount"}]},
    {"$eq": ["$path", ""]},
    {"$eq": ["$path", "/a"]},
    {"$eq": ["$path", "/a/hi"]},
    {"$every": {"_item0": "$['groups'][*]"}, "$satisfies": {"$every": {"_item1": "$_item0['rows'][*]"}, "$satisfies": {"$or": [{"$not": {"$let": {"value": {"$default": ["$_item0", {"$const": null}]}, "pointer": {"$const": "/groups/-"}}, "$return": "$value.show"}}, {"$or": [{"$not": {"$let": {"value": {"$default": ["$_item1", {"$const": null}]}, "pointer": {"$const": "/groups/-/rows/-"}}, "$return": "$value.show"}}, {"$let": {"value": {"$default": ["$_item1['name']", {"$const": null}]}, "pointer": {"$const": "/groups/-/rows/-/name"}}, "$return": {"$ne": ["$value", ""]}}]}]}}},
    {"$every": {"_item0": "$['lines'][*]"}, "$satisfies": {"$let": {"value": {"$default": ["$_item0['amount']", {"$const": null}]}, "pointer": {"$const": "/lines/-/amount"}}, "$return": {"$gt": ["$value", 0]}}},
    {"$every": {"l": "$.lines[*]"}, "$satisfies": {"$gt": ["$l.qty", 0]}},
    {"$exists": "$..*"},
    {"$exists": {"$assert": ["$.price", {"type": "number"}]}},
    {"$exists": {"$map": [["$.k", 1]]}},
    {"$ge": ["$.price", "$minPrice"]},
    {"$ge": ["$.total", 0]},
    {"$gt": ["$", 0]},
    {"$gt": [{"$add": ["$", 1]}, 0]},
    {"$gt": [{"$add": ["$.a", 1]}, 0]},
    {"$gt": [{"$count": {"$range": [0, {"$if": [{"$eq": ["$", null]}, 2000000, 3]}]}}, 0]},
    {"$gt": [{"$count": {"$reverse": {"$range": [0, "$.n"]}}}, 0]},
    {"$idiv": ["$.a", 0]},
    {"$le": ["$.lo", "$.hi"]},
    {"$le": ["$.start", "$.end"]},
    {"$let": {"value": {"$default": ["$['a']", {"$const": null}]}, "pointer": {"$const": "/a"}}, "$return": {"$gt": ["$.a", 0]}},
    {"$let": {"value": {"$default": ["$['nick']", {"$const": null}]}, "pointer": {"$const": "/nick"}}, "$return": {"$ne": ["$value", "root"]}},
    {"$let": {"value": {"$default": ["$['vatId']", {"$const": null}]}, "pointer": {"$const": "/vatId"}}, "$return": {"$or": [{"$eq": ["$.company", ""]}, {"$ne": ["$.vatId", ""]}]}},
    {"$or": [{"$not": {"$let": {"value": {"$default": ["$['group']", {"$const": null}]}, "pointer": {"$const": "/group"}}, "$return": {"$and": ["$value.show", {"$eq": ["$pointer", "/group"]}]}}}, {"$let": {"value": {"$default": ["$['group']['name']", {"$const": null}]}, "pointer": {"$const": "/group/name"}}, "$return": {"$ne": ["$value", ""]}}]},
    {"$sort": "$.xs[*]"},
    {"$valid": ["$.a", {"$query": {"$gt": [{"$count": {"$range": [0, {"$if": [{"$eq": ["$", null]}, 2000000, 3]}]}}, 0]}}]},
    {"$valid": ["$.child", {"type": "object", "$query": {"$le": ["$.lo", "$.hi"]}}]},
    {"$valid": ["$.lines[*].amount", {"$ref": "https://jarenjs.dev/schemas/test/money"}]}
  ]
}
