  {
    "file": "const.json",
    "description": "const validation",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "const": 2
    },
    "tests": [
      {
        "description": "same value is valid",
        "data": 2,
        "valid": true
      },
      {
        "description": "another value is invalid",
        "data": 5,
        "valid": false
